// PolarisHelper —— 北辰 Polaris Windows 提权服务。
//
// 职责（安全范式对齐 Bettbox services/helper）：
//  1. 以 LocalSystem 运行的 Windows 服务，监听命名管道（SDDL 限定本地）；
//  2. 每请求 HMAC-SHA256(timestamp:body) 签名校验（密钥由安装期经 UAC
//     写入服务环境变量 POLARIS_HELPER_AUTH_KEY，服务独占可读）；
//  3. start_core 前校验被拉起 PolarisCore.exe 的 SHA-256 与编译期白名单一致
//     （-ldflags "-X main.coreSHA256=<hash>[,<hash>...]"），防替换攻击；
//  4. 由服务拉起的 core 继承 SYSTEM 权限，TUN（wintun）因此可用。
//
// 命令行：
//
//	（无参数）      以服务方式运行（由 SCM 拉起）
//	--console       前台调试模式（读当前进程环境变量）
//	--install       安装服务并写入认证密钥（需管理员）
//	--uninstall     卸载服务（需管理员）
//	--identity X    管道/服务名后缀（dev/正式双身份，默认 Polaris.Helper）

package main

import (
	"fmt"
	"os"

	"golang.org/x/sys/windows/svc"
)

var (
	identity   = "Polaris.Helper"
	coreSHA256 string // 编译期注入的合法 core 哈希白名单，逗号分隔
)

func main() {
	args := os.Args[1:]
	for i := 0; i < len(args); i++ {
		switch args[i] {
		case "--identity":
			if i+1 < len(args) {
				i++
				identity = args[i]
			}
		}
	}

	isInteractive, err := svc.IsWindowsService()
	if err != nil {
		fmt.Fprintf(os.Stderr, "PolarisHelper: IsWindowsService: %v\n", err)
		os.Exit(1)
	}

	if len(args) > 0 {
		switch args[0] {
		case "--install":
			install()
			return
		case "--uninstall":
			uninstall()
			return
		case "--console":
			runConsole()
			return
		}
	}

	if !isInteractive {
		fmt.Fprintln(os.Stderr, "PolarisHelper: 请以服务方式运行或使用 --console")
		os.Exit(2)
	}

	if err := svc.Run(serviceName(), &polarisService{}); err != nil {
		fmt.Fprintf(os.Stderr, "PolarisHelper: svc.Run: %v\n", err)
		os.Exit(1)
	}
}
