package main

// 服务生命周期与 SCM 集成（golang.org/x/sys/windows/svc）。

import (
	"sync"

	"golang.org/x/sys/windows/svc"
)

var (
	mu      sync.Mutex
	running bool
	stopCh  chan struct{}
)

func serviceName() string { return identity }

type polarisService struct{}

func (s *polarisService) Execute(_ []string, req <-chan svc.ChangeRequest, status chan<- svc.Status) (bool, uint32) {
	const accepted = svc.AcceptStop | svc.AcceptShutdown

	status <- svc.Status{State: svc.StartPending}

	mu.Lock()
	running = true
	stopCh = make(chan struct{})
	stop := stopCh
	mu.Unlock()

	go servePipe(stop)

	status <- svc.Status{State: svc.Running, Accepts: accepted}

	for c := range req {
		switch c.Cmd {
		case svc.Interrogate:
			status <- c.CurrentStatus
		case svc.Stop, svc.Shutdown:
			status <- svc.Status{State: svc.StopPending}

			mu.Lock()
			if running {
				running = false
				close(stop)
			}
			mu.Unlock()

			killAllCores()
			wgWait()

			return false, 0
		}
	}

	return false, 0
}

// runConsole 前台调试模式：与服务的管道监听行为一致，密钥读当前进程环境。
func runConsole() {
	stop := make(chan struct{})
	go servePipe(stop)

	select {}
}
