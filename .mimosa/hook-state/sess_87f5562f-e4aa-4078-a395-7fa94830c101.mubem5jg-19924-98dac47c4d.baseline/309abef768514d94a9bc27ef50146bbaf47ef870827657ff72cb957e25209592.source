package cc.polaris.desktop.panel.data.local

import cc.polaris.desktop.panel.remote.DeskLog
import cc.polaris.desktop.panel.remote.config.ConfigValidation
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.withContext
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.Json
import okhttp3.HttpUrl.Companion.toHttpUrlOrNull

/**
 * 桌面版运行时面板地址存储（批2 A 项）：替代安卓 `data/local/ApiUrlStore.kt`。
 *
 * 与安卓语义一致：
 * - 登录页提交的自定义面板地址是唯一来源，不内置、不兜底任何默认地址；
 *   未保存地址时 [effectiveBaseUrl] 为空串，网络层视为「面板地址未配置」快速失败；
 * - 地址在登录提交时写入，ApiFailoverInterceptor / AuthInterceptor 请求期实时读取，
 *   改完地址无需重启进程即可生效。
 *
 * 桌面适配差异：
 * - 安卓为 `@Singleton class` + Hilt 构造注入 + EncryptedSharedPreferences；
 *   桌面为 `object`（手动 DI，R5）+ JSON 文件 `%APPDATA%/Polaris/panel/api_url.json`
 *   （key：`panel_url` / `backend_type`，与安卓 prefs key 同名）；
 * - 地址规范化复用 R8 移植的 [ConfigValidation.normalizePanelUrl]（与安卓调用关系一致）；
 * - 安卓 backendType 未持久化时回退 `BuildConfig.API_TYPE`；桌面无编译期注入，
 *   默认 `"xiaov2b"`（与 DualBackendAuthApi 的 else 分支一致）；
 * - 同时提供 [backendTypeFlow]（任务要求的 StateFlow）与 [backendType]
 *   （String 同步读属性，批1 DualBackendAuthApi 按 `when (apiUrlStore.backendType)` 消费，两者保持同步）。
 */
object ApiUrlStore {

    /** api_url.json 的键名照抄安卓 prefs：panel_url / backend_type */
    @Serializable
    private data class Persisted(
        val panelUrl: String? = null,
        val backendType: String? = null,
    )

    private const val FILE_NAME = "api_url.json"

    /** 安卓回退 BuildConfig.API_TYPE；桌面无编译期注入，取双后端代理的默认路由目标 */
    private const val DEFAULT_BACKEND_TYPE = "xiaov2b"

    private val json =
        Json {
            ignoreUnknownKeys = true
            isLenient = true
        }

    private val lock = Any()

    // 内存快照单源（T15 评审修复：读-改-写竞态 + lazy 与盘上状态脱节）
    private var persisted: Persisted = loadPersisted()

    private fun loadPersisted(): Persisted =
        PanelStorage.readText(FILE_NAME)
            ?.let { raw ->
                runCatching { json.decodeFromString<Persisted>(raw) }
                    .onFailure {
                        // 文件损坏视为未配置（面板地址缺失会让网络层快速失败，不会误连旧地址）
                        DeskLog.w("Polaris-ApiUrl", "ApiUrlStore: api_url.json 解析失败，按未配置处理: ${DeskLog.sanitize(it.message ?: "Unknown")}")
                    }
                    .getOrNull()
            }
            ?: Persisted()

    private val _urlFlow = MutableStateFlow(persisted.panelUrl?.let { ConfigValidation.normalizePanelUrl(it) })

    /** 已保存的用户面板地址流；null 表示未配置 */
    val urlFlow: StateFlow<String?> = _urlFlow.asStateFlow()

    /** 当前生效的用户面板地址（同步读取，供拦截器在请求线程使用） */
    val currentUrl: String?
        get() = _urlFlow.value

    /** 实际生效的 API 基地址；未配置时为空串（不回退任何内置地址） */
    fun effectiveBaseUrl(): String = currentUrl?.takeIf { it.toHttpUrlOrNull() != null }.orEmpty()

    private val _backendTypeFlow =
        MutableStateFlow(persisted.backendType?.takeIf { it.isNotBlank() } ?: DEFAULT_BACKEND_TYPE)

    /** 运行时后端类型流：`xiaov2b` / `xboard` */
    val backendTypeFlow: StateFlow<String> = _backendTypeFlow.asStateFlow()

    /** 当前运行时后端类型（同步读；与 [backendTypeFlow] 保持一致） */
    val backendType: String
        get() = _backendTypeFlow.value

    /** 持久化后端类型（登录页切换后调用，先落盘供下次冷启动读取，再更新内存流） */
    suspend fun setBackendType(type: String) {
        withContext(Dispatchers.IO) {
            updatePersisted { it.copy(backendType = type) }
        }
        _backendTypeFlow.value = type
    }

    /**
     * 保存自定义面板地址（null / 空白 = 清除）。
     * 先落盘再更新内存流，保证后续请求立刻使用新地址。
     */
    suspend fun setUrl(url: String?) {
        val normalized = ConfigValidation.normalizePanelUrl(url)
        withContext(Dispatchers.IO) {
            updatePersisted { it.copy(panelUrl = normalized) }
        }
        _urlFlow.value = normalized
    }

    /**
     * 判断 host 是否属于当前自定义面板的主机（含子域名）。
     * AuthInterceptor 用它把自定义面板并入 token 注入白名单，否则登录会失败。
     */
    fun isCurrentHost(host: String?): Boolean {
        val customHost = currentUrl?.toHttpUrlOrNull()?.host?.lowercase() ?: return false
        val target = host?.lowercase() ?: return false
        return target == customHost || target.endsWith(".$customHost")
    }

    private fun updatePersisted(update: (Persisted) -> Persisted) {
        synchronized(lock) {
            val next = update(persisted)
            PanelStorage.writeTextAtomic(FILE_NAME, json.encodeToString(Persisted.serializer(), next))
            persisted = next
        }
    }
}
