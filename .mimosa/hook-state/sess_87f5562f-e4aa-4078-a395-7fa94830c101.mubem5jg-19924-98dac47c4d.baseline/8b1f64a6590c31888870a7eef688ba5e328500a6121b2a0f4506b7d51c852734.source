package cc.polaris.desktop.ui

import androidx.compose.runtime.Composable
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.runtime.collectAsState
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.remember
import androidx.compose.runtime.setValue
import androidx.compose.material3.CircularProgressIndicator
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.Arrangement
import androidx.compose.foundation.layout.Column
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import cc.polaris.desktop.core.CoreManager
import cc.polaris.desktop.panel.PanelGraph
import cc.polaris.desktop.panel.data.local.DesktopKernelHooks
import cc.polaris.desktop.panel.domain.model.SessionState
import cc.polaris.desktop.panel.domain.model.parseHostnameForSiteName
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

/** 注销钩子：停内核 + 清该账号 profile 目录（T15d 接线；细粒度 profile 管理在 T15h）。 */
internal fun coreKernelHooks(manager: CoreManager) = DesktopKernelHooks(
    deleteAccountProfiles = { _ ->
        runCatching { manager.stop() }
        runCatching {
            manager.appHome.resolve("profiles").toFile().deleteRecursively()
        }

        Unit
    },
    stopVpn = {
        runCatching { kotlinx.coroutines.runBlocking { manager.stop() } }
    },
)

/** 页面路由壳：会话驱动（登录页 ↔ 主界面），Bettbox 式侧栏。 */
@Composable
fun AppRoot(manager: CoreManager) {
    val sessionState by PanelGraph.authRepository.sessionState.collectAsState()

    BettboxTheme {
        // 恢复上次的深浅主题偏好；无偏好时跟随 Windows 系统深色设置
        LaunchedEffect(Unit) {
            val pref = withContext(Dispatchers.IO) {
                runCatching {
                    cc.polaris.desktop.panel.data.local.PanelStorage.readText("ui.json")
                }.getOrNull()
            }
            BettboxColors.isDark = when {
                pref?.contains("\"dark\":true") == true -> true
                pref?.contains("\"dark\":false") == true -> false
                else -> runCatching {
                    // AppsUseLightTheme = 0 表示系统处于深色模式
                    val key = "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize"
                    val out = java.util.regex.Pattern.compile("AppsUseLightTheme\\s+REG_DWORD\\s+0x(\\d+)")
                        .matcher(java.lang.ProcessBuilder("reg", "query", key, "/v", "AppsUseLightTheme")
                            .start().inputStream.readBytes().toString(Charsets.UTF_8))
                    out.find() && out.group(1) == "0"
                }.getOrDefault(false)
            }
        }

        when (val state = sessionState) {
            SessionState.Loading -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                CircularProgressIndicator()
            }

            SessionState.LoggedOut -> LoginScreen()

            is SessionState.LoggedIn -> {
                // 登录/恢复会话后自动同步订阅并生效（对齐安卓：登录即就绪，无需手动配置）
                LaunchedEffect(state.user.email) {
                    ensureSubscriptionApplied(manager)
                }
                MainShell(manager, state.user)
            }
        }
    }
}

@Composable
private fun MainShell(manager: CoreManager, user: cc.polaris.desktop.panel.domain.model.User) {
    var selected by remember { mutableStateOf(NavPage.HOME) }

    // 左上角站点名：面板 guest/comm/config 下发（对齐安卓），兜底面板域名派生
    var siteName by remember { mutableStateOf("") }
    LaunchedEffect(user.email) {
        val info = withContext(Dispatchers.IO) {
            runCatching { PanelGraph.authRepository.fetchSiteInfo() }.getOrNull()
        }
        siteName = info?.appName?.takeIf { it.isNotBlank() }
            ?: run {
                val panelUrl = cc.polaris.desktop.panel.data.local.ApiUrlStore.currentUrl
                panelUrl.parseHostnameForSiteName() ?: "北辰 Polaris"
            }
    }

    NavShell(current = selected, onSelect = { selected = it }, siteName = siteName.ifBlank { "北辰 Polaris" }) {
        when (selected) {
            NavPage.HOME -> DashboardScreen(manager)
            NavPage.LOGS -> LogScreen(manager)
            NavPage.MORE -> MoreScreen(manager)
            NavPage.PROXIES -> ProxiesScreen(manager)
            NavPage.CONNECTIONS -> ConnectionsScreen(manager)
        }
    }
}
