package cc.polaris.desktop.panel.repository

import cc.polaris.desktop.panel.domain.model.TrafficLogRecord
import cc.polaris.desktop.panel.remote.api.AuthApi

/**
 * 流量日志 Repository（批3）：移植自安卓 `data/repository/TrafficRepository.kt`。
 * 桌面适配：`@Singleton class + @Inject 构造` → 去注解 class，构造参数显式传入；
 * 其余逐行照抄。
 */
class TrafficRepository(
    private val authApi: AuthApi,
) {
    suspend fun fetchTrafficLog(): Result<List<TrafficLogRecord>> = runApi {
        authApi.fetchTrafficLog()
    }
}
