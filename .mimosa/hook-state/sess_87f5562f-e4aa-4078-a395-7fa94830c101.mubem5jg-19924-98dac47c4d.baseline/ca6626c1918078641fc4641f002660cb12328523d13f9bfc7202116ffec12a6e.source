package cc.polaris.desktop.panel

import cc.polaris.desktop.panel.data.local.ApiUrlStore
import cc.polaris.desktop.panel.data.local.CredentialStore
import cc.polaris.desktop.panel.data.local.DesktopKernelHooks
import cc.polaris.desktop.panel.data.local.SessionManager
import cc.polaris.desktop.panel.data.local.SessionStore
import cc.polaris.desktop.panel.remote.ApiBackend
import cc.polaris.desktop.panel.remote.AuthInterceptor
import cc.polaris.desktop.panel.remote.BackendAdapterFactory
import cc.polaris.desktop.panel.remote.DeskEnv
import cc.polaris.desktop.panel.remote.DeskRemoteConfig
import cc.polaris.desktop.panel.remote.FallbackDns
import cc.polaris.desktop.panel.repository.AuthRepository
import cc.polaris.desktop.panel.repository.GiftCardRepository
import cc.polaris.desktop.panel.repository.InviteRepository
import cc.polaris.desktop.panel.repository.OrderRepository
import cc.polaris.desktop.panel.repository.ServerRepository
import cc.polaris.desktop.panel.repository.SubscribeRepository
import cc.polaris.desktop.panel.repository.TicketRepository
import cc.polaris.desktop.panel.repository.TrafficRepository

/**
 * 桌面端手动组装根（替代安卓 Hilt）。
 * init() 幂等；AppRoot 首次组合时调用，kernelHooks 由内核侧注入。
 *
 * baseUrl 说明：Retrofit 需要合法 http(s) baseUrl；未登录时 ApiUrlStore 可能为空，
 * 此处用占位主机构造，实际请求 host 由 AuthInterceptor/ApiFailoverInterceptor 按
 * ApiUrlStore.effectiveBaseUrl() 运行时改写（与安卓「运行时唯一来源=用户输入」语义一致）。
 */
object PanelGraph {

    lateinit var authRepository: AuthRepository
        private set
    lateinit var serverRepository: ServerRepository
        private set
    lateinit var subscribeRepository: SubscribeRepository
        private set
    lateinit var ticketRepository: TicketRepository
        private set
    lateinit var trafficRepository: TrafficRepository
        private set
    lateinit var inviteRepository: InviteRepository
        private set
    lateinit var giftCardRepository: GiftCardRepository
        private set
    lateinit var orderRepository: OrderRepository
        private set

    @Volatile
    private var initialized = false

    fun init(kernelHooks: DesktopKernelHooks = DesktopKernelHooks.NONE) {
        if (initialized) {
            return
        }

        synchronized(this) {
            if (initialized) {
                return
            }

            val authInterceptor = AuthInterceptor(SessionStore, ApiUrlStore)
            val dns = FallbackDns()
            SessionManager.install(authInterceptor, dns, kernelHooks)

            // effectiveBaseUrl() 未配置时返回空串（非 null），?: 不会触发（T15 修复：启动即崩
            // IllegalArgumentException: Expected URL scheme 'http' or 'https'）。用 ifBlank 兜底，
            // 占位符仅满足 Retrofit 构造；实际请求由拦截器按 ApiUrlStore 实时读取真实地址。
            val baseUrl = ApiUrlStore.effectiveBaseUrl().ifBlank { "https://polaris-placeholder.invalid" }
            val api = BackendAdapterFactory.createDualAuthApi(
                backend = ApiBackend(type = ApiUrlStore.backendType, baseUrl = baseUrl),
                isDebug = DeskEnv.DEBUG,
                authInterceptor = authInterceptor,
                dns = dns,
                remoteConfig = DeskRemoteConfig,
                apiUrlStore = ApiUrlStore,
            )

            subscribeRepository = SubscribeRepository(api, SessionStore, SessionManager)
            authRepository = AuthRepository(api, SessionStore, CredentialStore, SessionManager, subscribeRepository)
            serverRepository = ServerRepository(api, SessionStore)
            ticketRepository = TicketRepository(api, SessionManager)
            trafficRepository = TrafficRepository(api)
            inviteRepository = InviteRepository(api)
            giftCardRepository = GiftCardRepository(api)
            orderRepository = OrderRepository(api)

            initialized = true
        }
    }
}
