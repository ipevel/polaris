private fun stateLabel(state: ConnState): String = when (state) {
    ConnState.DISCONNECTED -> "未连接"
    ConnState.CONNECTING -> "连接中…"
    ConnState.CONNECTED -> "已连接"
    ConnState.DISCONNECTING -> "断开中…"
}

/** 速率格式化：自适应 B/s → MB/s。 */
fun formatRate(bytesPerSec: Long): String = when {
    bytesPerSec >= 1 shl 20 -> String.format(Locale.ROOT, "%.2f MB/s", bytesPerSec / 1048576.0)
    bytesPerSec >= 1 shl 10 -> String.format(Locale.ROOT, "%.1f KB/s", bytesPerSec / 1024.0)
    else -> "$bytesPerSec B/s"
}

/** 累计流量格式化。 */
fun formatBytes(bytes: Long): String = when {
    bytes >= 1L shl 30 -> String.format(Locale.ROOT, "%.2f GB", bytes / 1073741824.0)
    bytes >= 1L shl 20 -> String.format(Locale.ROOT, "%.1f MB", bytes / 1048576.0)
    bytes >= 1L shl 10 -> String.format(Locale.ROOT, "%.1f KB", bytes / 1024.0)
    else -> "$bytes B"
}

/** 实时速度折线：↑（绿）/ ↓（蓝）双序列。 */
@Composable
fun SpeedChart(samples: List<TrafficSample>, modifier: Modifier = Modifier) {
    val upColor = BettboxColors.upColor
    val downColor = BettboxColors.downColor

    Canvas(modifier.height(150.dp).fillMaxWidth()) {
        if (samples.size < 2) return@Canvas

        val peak = max(1L, samples.maxOf { max(it.up, it.down) }).toFloat()
        val stepX = size.width / (samples.size - 1)

        fun seriesPath(selector: (TrafficSample) -> Long): Path {
            val path = Path()
            samples.forEachIndexed { i, s ->
                val x = i * stepX
                val y = size.height - (selector(s).toFloat() / peak) * size.height * 0.92f
                if (i == 0) path.moveTo(x, y) else path.lineTo(x, y)
            }
            return path
        }

        drawPath(seriesPath { it.down }, downColor, style = Stroke(width = 5f))
        drawPath(seriesPath { it.up }, upColor, style = Stroke(width = 5f))
    }
}

/** 首页（测试版极简）：连接 + 实时速度 + 实时流量。 */
@Composable
fun DashboardScreen(manager: CoreManager) {
    val status by manager.status.collectAsState()
    val traffic by manager.traffic.collectAsState()
    val scope = rememberCoroutineScope()
    var syncing by remember { mutableStateOf(false) }
    var message by remember { mutableStateOf<String?>(null) }

    val latest = traffic.lastOrNull()
    var sessionUp by remember { mutableStateOf(manager.sessionTotalUp) }
    var sessionDown by remember { mutableStateOf(manager.sessionTotalDown) }
    LaunchedEffect(traffic.size) {
        sessionUp = manager.sessionTotalUp
        sessionDown = manager.sessionTotalDown
    }

    val connected = status.state == ConnState.CONNECTED
    val busy = status.state == ConnState.CONNECTING || status.state == ConnState.DISCONNECTING || syncing

    // 订阅套餐信息（首页展示，对齐安卓首页站点/套餐卡）
    var subscribeInfo by remember { mutableStateOf<SubscribeInfo?>(null) }
    var sysProxy by remember { mutableStateOf(false) }
    var autoStart by remember { mutableStateOf(false) }
    var tunOn by remember { mutableStateOf(manager.tunConfig.enable) }

    LaunchedEffect(Unit) {
        subscribeInfo = withContext(Dispatchers.IO) {
            runCatching { PanelGraph.subscribeRepository.fetchSubscribeInfo(force = false) }.getOrNull()
        }?.getOrNull()
        sysProxy = withContext(Dispatchers.IO) { SystemProxy.currentLocalPort() != null }
        autoStart = withContext(Dispatchers.IO) { runCatching { AutoStart.enabled() }.getOrDefault(false) }
    }

    // 连接成功后系统代理由内核链路自动开启：回读真实状态同步开关
    LaunchedEffect(status.state, status.profileLoaded) {
        sysProxy = withContext(Dispatchers.IO) { SystemProxy.currentLocalPort() != null }
    }

    // 虚拟网卡需要管理员权限：未装提权服务时确认提示
    var showTunAdminTip by remember { mutableStateOf(false) }

    // 进程已挂但订阅未生效：对用户表现为「还在连接」，自动补齐
    LaunchedEffect(status.state, status.profileLoaded) {
        if (status.state == ConnState.CONNECTED && !status.profileLoaded) {
            ensureSubscriptionApplied(manager, force = true).let { if (it != null) message = it }
        }
    }

    Column(
        Modifier.fillMaxSize().verticalScroll(rememberScrollState()),
        verticalArrangement = Arrangement.spacedBy(12.dp),
    ) {
        // ---- 第一行：连接状态 | 我的套餐（小卡并排，占位小） ----
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(12.dp)) {
            CommonCard(Modifier.weight(1f)) {
                Text("连接状态", style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.outline)
                Spacer(Modifier.height(6.dp))
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Box(
                        Modifier.size(10.dp).background(
                            when {
                                connected && status.profileLoaded -> BettboxColors.upColor
                                connected -> BettboxColors.accentContainer
                                else -> MaterialTheme.colorScheme.outline
                            },
                            CircleShape,
                        ),
                    )
                    Spacer(Modifier.width(8.dp))
                    Text(
                        if (connected && !status.profileLoaded) "连接中…" else stateLabel(status.state),
                        style = MaterialTheme.typography.titleMedium,
                        fontWeight = FontWeight.Bold,
                    )
                    Spacer(Modifier.weight(1f))
                    if (busy) {
                        CircularProgressIndicator(Modifier.size(18.dp), strokeWidth = 2.dp)
                    }
                }
                Spacer(Modifier.height(8.dp))
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    Button(
                        onClick = {
                            scope.launch {
                                syncing = true
                                message = ensureSubscriptionApplied(manager)
                                manager.start(manager.defaultProfileDir)
                                syncing = false
                            }
                        },
                        enabled = status.state == ConnState.DISCONNECTED && !syncing,
                        modifier = Modifier.height(34.dp),
                        contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = 14.dp),
                    ) { Text("连接", style = MaterialTheme.typography.labelLarge) }
                    OutlinedButton(
                        onClick = { scope.launch { manager.stop() } },
                        enabled = connected,
                        modifier = Modifier.height(34.dp),
                        contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = 14.dp),
                    ) { Text("断开", style = MaterialTheme.typography.labelLarge) }
                }
                message?.let {
                    Spacer(Modifier.height(6.dp))
                    Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall)
                }
                status.error?.let {
                    Spacer(Modifier.height(6.dp))
                    Text("连接失败：$it", color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall)
                }
            }

            CommonCard(Modifier.weight(1f)) {
                Text("我的套餐", style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.outline)
                Spacer(Modifier.height(6.dp))
                when {
                    subscribeInfo == null -> Text("加载中…", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.outline)

                    subscribeInfo?.hasPlan != true -> Text("暂无有效套餐", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.outline)

                    else -> {
                        val info = subscribeInfo!!
                        val daysLeft = DaysUntilExpiryUseCase()(info.expiredAt)
                        val pct = if (info.transferEnable > 0) {
                            (info.usedTraffic * 100 / info.transferEnable).toInt().coerceIn(0, 100)
                        } else {
                            0
                        }

                        Row(verticalAlignment = Alignment.CenterVertically) {
                            Text(info.planName, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Bold, color = BettboxColors.accent)
                            Spacer(Modifier.weight(1f))
                            if (info.expired) {
                                Text("已过期", color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.labelSmall)
                            } else if (info.expiredAt > 0) {
                                Text("剩 $daysLeft 天", style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
                            }
                        }

                        Spacer(Modifier.height(8.dp))
                        Box(
                            Modifier.fillMaxWidth().height(6.dp).clip(RoundedCornerShape(3.dp))
                                .background(MaterialTheme.colorScheme.surfaceVariant),
                        ) {
                            Box(
                                Modifier.fillMaxWidth(pct / 100f).height(6.dp).clip(RoundedCornerShape(3.dp))
                                    .background(BettboxColors.accent),
                            )
                        }
                        Spacer(Modifier.height(6.dp))
                        Text(
                            "已用 ${formatBytes(info.usedTraffic)} / ${formatBytes(info.transferEnable)}（$pct%）" +
                                if (info.expiredAt > 0) {
                                    " · 到期 " + DateTimeFormatter.ofPattern("yyyy-MM-dd")
                                        .format(Instant.ofEpochSecond(info.expiredAt).atZone(ZoneId.systemDefault()))
                                } else {
                                    ""
                                },
                            style = MaterialTheme.typography.labelSmall,
                            color = MaterialTheme.colorScheme.onSurfaceVariant,
                        )
                    }
                }
            }
        }

        // ---- 第二行：实时速度（宽卡带折线） | 实时流量（小卡） ----
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(12.dp)) {
            CommonCard(Modifier.weight(1.6f)) {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Text("实时速度", style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.outline)
                    Spacer(Modifier.weight(1f))
                    Text("↑ ${formatRate(latest?.up ?: 0)}", color = BettboxColors.upColor, style = MaterialTheme.typography.labelLarge, fontWeight = FontWeight.SemiBold)
                    Spacer(Modifier.width(10.dp))
                    Text("↓ ${formatRate(latest?.down ?: 0)}", color = BettboxColors.downColor, style = MaterialTheme.typography.labelLarge, fontWeight = FontWeight.SemiBold)
                }
                Spacer(Modifier.height(6.dp))
                if (traffic.size < 2) {
                    Text(
                        if (connected) "正在采样…" else "连接后显示实时速度",
                        style = MaterialTheme.typography.bodySmall,
                        color = MaterialTheme.colorScheme.outline,
                        modifier = Modifier.height(96.dp).fillMaxWidth(),
                    )
                } else {
                    SpeedChart(traffic)
                }
            }

            CommonCard(Modifier.weight(1f)) {
                Text("实时流量", style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.outline)
                Spacer(Modifier.height(6.dp))
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Text("↑", color = BettboxColors.upColor, style = MaterialTheme.typography.labelLarge)
                    Spacer(Modifier.width(6.dp))
                    Text(formatBytes(sessionUp), color = BettboxColors.upColor, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
                }
                Spacer(Modifier.height(4.dp))
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Text("↓", color = BettboxColors.downColor, style = MaterialTheme.typography.labelLarge)
                    Spacer(Modifier.width(6.dp))
                    Text(formatBytes(sessionDown), color = BettboxColors.downColor, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
                }
            }
        }

        // ---- 开关卡：虚拟网卡 / 开机自启（系统代理随连接自动启停，不再单独显示） ----
        Row(horizontalArrangement = Arrangement.spacedBy(16.dp), modifier = Modifier.fillMaxWidth()) {
            SwitchCard(Modifier.weight(1f), "虚拟网卡", tunOn, "需管理员权限") { checked ->
                if (checked && !status.elevated) {
                    // 未装提权服务：先告知权限要求（用户反馈）
                    showTunAdminTip = true
                } else {
                    tunOn = checked
                    manager.tunConfig = manager.tunConfig.copy(enable = checked)
                }
            }
            SwitchCard(Modifier.weight(1f), "开机自启", autoStart, "登录 Windows 后自动运行") { checked ->
                scope.launch {
                    val ok = withContext(Dispatchers.IO) {
                        runCatching {
                            if (checked) {
                                AutoStart.enable(ProcessHandle.current().info().command().orElse("PolarisDesktop.exe"))
                            } else {
                                AutoStart.disable()
                            }
                        }.getOrDefault(false)
                    }
                    autoStart = ok
                }
            }
        }
    }

    if (showTunAdminTip) {
        androidx.compose.material3.AlertDialog(
            onDismissRequest = { showTunAdminTip = false },
            title = { Text("需要管理员权限") },
            text = {
                Text(
                    "虚拟网卡（TUN）需要管理员权限才能接管全部流量。\n\n当前未检测到提权服务，此开关暂不会生效。" +
                        "如需使用，请右键程序选择「以管理员身份运行」。",
                )
            },
            confirmButton = {
                TextButton(onClick = {
                    showTunAdminTip = false
                    tunOn = true
                    manager.tunConfig = manager.tunConfig.copy(enable = true)
                }) { Text("仍要开启") }
            },
            dismissButton = {
                TextButton(onClick = { showTunAdminTip = false }) { Text("取消") }
            },
        )
    }
}

@Composable
private fun SwitchCard(
    modifier: Modifier,
    title: String,
    checked: Boolean,
    subtitle: String,
    onToggle: (Boolean) -> Unit,
) {
    CommonCard(modifier) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Column(Modifier.weight(1f)) {
                Text(title, style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.SemiBold)
                Text(subtitle, style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.outline)
            }
            Switch(
                checked = checked,
                onCheckedChange = onToggle,
                colors = SwitchDefaults.colors(checkedTrackColor = BettboxColors.accent),
            )
        }
    }
}
