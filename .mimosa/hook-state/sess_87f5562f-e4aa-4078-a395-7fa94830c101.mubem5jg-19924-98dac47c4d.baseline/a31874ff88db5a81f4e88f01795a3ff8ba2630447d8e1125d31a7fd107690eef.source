/**
 * 「更多」页（T15e）：对齐安卓 Profile + Usage 语义。
 * 用户卡（邮箱/余额/登出）+ 套餐卡（流量用量/剩余天数/订阅链接）+ 系统设置分区。
 */
@Composable
fun MoreScreen(manager: CoreManager) {
    val scope = rememberCoroutineScope()
    val sessionState by PanelGraph.authRepository.sessionState.collectAsState()
    val user = (sessionState as? cc.polaris.desktop.panel.domain.model.SessionState.LoggedIn)?.user

    var feedback by remember { mutableStateOf<String?>(null) }

    Column(
        Modifier.fillMaxSize().verticalScroll(rememberScrollState()),
        verticalArrangement = Arrangement.spacedBy(12.dp),
    ) {
        PageHeader("更多", "账户与服务管理")

        // ---- 用户卡 ----
        CommonCard(Modifier.fillMaxWidth()) {
            Row(verticalAlignment = Alignment.CenterVertically) {
                Box(
                    Modifier.width(44.dp).height(44.dp).background(BettboxColors.accent, RoundedCornerShape(12.dp)),
                    contentAlignment = Alignment.Center,
                ) {
                    Text(
                        (user?.email?.firstOrNull()?.uppercase() ?: "P"),
                        color = androidx.compose.ui.graphics.Color.White,
                        style = MaterialTheme.typography.titleMedium,
                    )
                }
                Spacer(Modifier.width(12.dp))
                Column(Modifier.weight(1f)) {
                    Text(user?.email ?: "未登录", style = MaterialTheme.typography.titleMedium, maxLines = 1, overflow = TextOverflow.Ellipsis)
                    Text("余额：¥${user?.balance ?: "0.00"}", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.outline)
                }
                OutlinedButton(
                    onClick = {
                        scope.launch {
                            runCatching { manager.stop() }
                            withContext(Dispatchers.IO) { PanelGraph.authRepository.logout() }
                        }
                    },
                    modifier = Modifier.height(34.dp),
                    contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = 14.dp),
                ) { Text("登出", style = MaterialTheme.typography.labelLarge) }
            }
        }

        // ---- 面板服务区（公告/工单/订单） ----
        // 套餐展示已归首页（用户反馈：首页加订阅套餐）
        PanelServicesSection()

        // ---- 系统设置分区 ----
        SystemSettingsSection(manager, onUpdateFeedback = { feedback = it })

        feedback?.let {
            Text(it, color = MaterialTheme.colorScheme.onSurfaceVariant, style = MaterialTheme.typography.bodySmall)
        }
    }
}

@Composable
private fun SystemSettingsSection(manager: CoreManager, onUpdateFeedback: (String) -> Unit) {
    val scope = rememberCoroutineScope()

    CommonCard(Modifier.fillMaxWidth()) {
        CardHeader("系统设置")
        Spacer(Modifier.height(8.dp))
        Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
            // 深色模式（黑白主题切换）
            var dark by remember { mutableStateOf(BettboxColors.isDark) }
            Row(verticalAlignment = Alignment.CenterVertically) {
                Column(Modifier.weight(1f)) {
                    Text("深色模式", style = MaterialTheme.typography.bodyMedium)
                    Text("黑 / 白主题切换", style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.outline)
                }
                Switch(
                    checked = dark,
                    onCheckedChange = { checked ->
                        dark = checked
                        BettboxColors.isDark = checked
                        scope.launch {
                            withContext(Dispatchers.IO) {
                                runCatching {
                                    cc.polaris.desktop.panel.data.local.PanelStorage.writeTextAtomic(
                                        "ui.json",
                                        if (checked) "{\"dark\":true}" else "{\"dark\":false}",
                                    )
                                }
                            }
                        }
                    },
                    colors = SwitchDefaults.colors(checkedTrackColor = BettboxColors.accent),
                )
            }

            // 更新检查：无需手填 URL（用户反馈）；直接检查内置发布源，不可用时给出跳转
            Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                Button(
                    onClick = {
                        scope.launch {
                            onUpdateFeedback(
                                try {
                                    manager.checkForUpdate("")
                                } catch (e: Exception) {
                                    "暂无内置更新源：请到项目发布页检查新版本（${e.message}）"
                                },
                            )
                        }
                    },
                ) { Text("检查更新") }
                TextButton(onClick = {
                    scope.launch {
                        withContext(Dispatchers.IO) {
                            runCatching {
                                java.awt.Desktop.getDesktop().browse(java.net.URI("https://github.com/"))
                            }
                        }
                    }
                }) { Text("打开发布页") }
                // 订阅运维兜底（自动同步失败时手动重拉，替代原配置页）
                TextButton(onClick = {
                    scope.launch {
                        onUpdateFeedback(
                            ensureSubscriptionApplied(manager, force = true) ?: "订阅已重新拉取并生效",
                        )
                    }
                }) { Text("重新拉取订阅") }
            }
            Text(
                "当前版本 v${cc.polaris.desktop.core.DESKTOP_VERSION} · 更新检查自动使用内置发布源",
                style = MaterialTheme.typography.labelSmall,
                color = MaterialTheme.colorScheme.outline,
            )
        }
    }
}
