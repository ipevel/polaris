// 北辰 Polaris —— Windows 桌面端（Compose Multiplatform Desktop）
// 独立 Gradle 工程：与 Android 工程按目录隔离，不共享构建逻辑。
// 纯 JVM 目标（Windows-only），沿用仓库的阿里云镜像开关（POLARIS_USE_MIRROR）。

plugins {
    kotlin("jvm") version "2.1.0"
    id("org.jetbrains.compose") version "1.7.3"
    id("org.jetbrains.kotlin.plugin.compose") version "2.1.0"
    id("org.jetbrains.kotlin.plugin.serialization") version "2.1.0"
}

dependencies {
    implementation(compose.desktop.currentOs)
    implementation(compose.material3)
    implementation(compose.materialIconsExtended)
    implementation("org.jetbrains.kotlinx:kotlinx-coroutines-core:1.9.0")
    implementation("org.jetbrains.kotlinx:kotlinx-coroutines-swing:1.9.0")
    implementation("org.jetbrains.kotlinx:kotlinx-serialization-json:1.7.3")
    // 面板对接网络栈（与安卓端 libs.versions.toml 版本对齐）
    implementation("com.squareup.okhttp3:okhttp:4.12.0")
    implementation("com.squareup.retrofit2:retrofit:2.11.0")
    implementation("com.squareup.retrofit2:converter-kotlinx-serialization:2.11.0")
    // CheckoutResultDto.fromRawJson 使用 org.json 解析（与安卓平台 API 对齐）
    implementation("org.json:json:20240303")
}

kotlin {
    jvmToolchain(17)
}

compose.desktop {
    application {
        mainClass = "cc.polaris.desktop.MainKt"
    }
}
