//go:build windows

package main

// tunnel.* 方法：策略组/节点/提供者。语义与 Android 端 native/tunnel.go 一一对应。
// healthCheck 为阻塞调用（可能持续数秒），宿主侧应使用宽松超时。
// tunnel.queryConnections / tunnel.closeConnection 为桌面专属（对齐 mihomo external
// controller /connections 语义；安卓端无此导出面）。

import (
	"encoding/json"
	"strings"

	"cfa/native/app"
	"cfa/native/tunnel"

	"github.com/metacubex/mihomo/tunnel/statistic"
)

type queryGroupNamesParams struct {
	ExcludeNotSelectable bool `json:"excludeNotSelectable"`
}

type queryGroupParams struct {
	Name string `json:"name"`
	Sort string `json:"sort"` // Default | Title | Delay
}

type healthCheckParams struct {
	Name string `json:"name"`
}

type patchSelectorParams struct {
	Selector string `json:"selector"`
	Name     string `json:"name"`
}

type updateProviderParams struct {
	Type string `json:"type"` // proxies | rules
	Name string `json:"name"`
}

type suspendParams struct {
	Suspended bool `json:"suspended"`
}

func tunnelQueryGroupNames(params json.RawMessage) (any, error) {
	var p queryGroupNamesParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	return tunnel.QueryProxyGroupNames(p.ExcludeNotSelectable), nil
}

func tunnelQueryGroup(params json.RawMessage) (any, error) {
	var p queryGroupParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	mode := tunnel.Default
	switch p.Sort {
	case "Title":
		mode = tunnel.Title
	case "Delay":
		mode = tunnel.Delay
	}

	return tunnel.QueryProxyGroup(p.Name, mode, app.SubtitlePattern()), nil
}

func tunnelHealthCheck(params json.RawMessage) (any, error) {
	var p healthCheckParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	tunnel.HealthCheck(p.Name)

	return nil, nil
}

func tunnelHealthCheckAll(_ json.RawMessage) (any, error) {
	tunnel.HealthCheckAll()

	return nil, nil
}

func tunnelPatchSelector(params json.RawMessage) (any, error) {
	var p patchSelectorParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	return map[string]bool{"patched": tunnel.PatchSelector(p.Selector, p.Name)}, nil
}

func tunnelQueryProviders(_ json.RawMessage) (any, error) {
	return tunnel.QueryProviders(), nil
}

func tunnelUpdateProvider(params json.RawMessage) (any, error) {
	var p updateProviderParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	return nil, tunnel.UpdateProvider(p.Type, p.Name)
}

func tunnelSuspend(params json.RawMessage) (any, error) {
	var p suspendParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	tunnel.Suspend(p.Suspended)

	return nil, nil
}

func init() {
	register("tunnel.queryGroupNames", tunnelQueryGroupNames)
	register("tunnel.queryGroup", tunnelQueryGroup)
	register("tunnel.healthCheck", tunnelHealthCheck)
	register("tunnel.healthCheckAll", tunnelHealthCheckAll)
	register("tunnel.patchSelector", tunnelPatchSelector)
	register("tunnel.queryProviders", tunnelQueryProviders)
	register("tunnel.updateProvider", tunnelUpdateProvider)
	register("tunnel.suspend", tunnelSuspend)
	register("tunnel.queryConnections", tunnelQueryConnections)
	register("tunnel.closeConnection", tunnelCloseConnection)
}

// ---- 桌面专属：活跃连接 ----

type connectionInfo struct {
	ID       string `json:"id"`
	Network  string `json:"network"`
	Type     string `json:"type"`
	Host     string `json:"host"`
	Process  string `json:"process"`
	Upload   int64  `json:"upload"`
	Download int64  `json:"download"`
	Start    int64  `json:"start"`
	Chains   string `json:"chains"`
	Rule     string `json:"rule"`
}

func tunnelQueryConnections(_ json.RawMessage) (any, error) {
	snap := statistic.DefaultManager.Snapshot()
	out := make([]connectionInfo, 0, len(snap.Connections))

	for _, info := range snap.Connections {
		md := info.Metadata
		host := md.Host
		if host == "" {
			host = md.RemoteAddress()
		}

		chain := make([]string, 0, len(info.Chain))
		for i := len(info.Chain) - 1; i >= 0; i-- {
			chain = append(chain, info.Chain[i])
		}

		out = append(out, connectionInfo{
			ID:       info.UUID.String(),
			Network:  md.NetWork.String(),
			Type:     md.Type.String(),
			Host:     host,
			Process:  md.Process,
			Upload:   info.UploadTotal.Load(),
			Download: info.DownloadTotal.Load(),
			Start:    info.Start.UnixMilli(),
			Chains:   strings.Join(chain, " → "),
			Rule:     info.Rule,
		})
	}

	return out, nil
}

type closeConnectionParams struct {
	ID string `json:"id"`
}

func tunnelCloseConnection(params json.RawMessage) (any, error) {
	var p closeConnectionParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	tracker := statistic.DefaultManager.Get(p.ID)
	if tracker == nil {
		return map[string]bool{"closed": false}, nil
	}

	if err := tracker.Close(); err != nil {
		return nil, err
	}

	return map[string]bool{"closed": true}, nil
}
