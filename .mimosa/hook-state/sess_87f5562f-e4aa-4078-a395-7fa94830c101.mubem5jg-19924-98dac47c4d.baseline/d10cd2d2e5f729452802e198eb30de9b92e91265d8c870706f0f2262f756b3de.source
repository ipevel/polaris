//go:build windows

package main

import (
	"strings"
	"time"

	"cfa/native/tunnel"

	"github.com/metacubex/mihomo/log"
)

// 事件泵：log + traffic（对齐 Android 端 native/log.go 与 native/traffic.go 语义）。

type logMessage struct {
	Level   string `json:"level"`
	Message string `json:"message"`
	Time    int64  `json:"time"`
}

type trafficMessage struct {
	Up   int64 `json:"up"`
	Down int64 `json:"down"`
}

func startLogPump() {
	go func() {
		sub := log.Subscribe()
		defer log.UnSubscribe(sub)

		for msg := range sub {
			if msg.LogLevel < log.Level() && !strings.HasPrefix(msg.Payload, "[APP]") {
				continue
			}

			pushEvent(Event{
				Event: "log",
				Payload: logMessage{
					Level:   msg.LogLevel.String(),
					Message: msg.Payload,
					Time:    time.Now().UnixMilli(),
				},
			})
		}
	}()
}

// startTrafficPump 每秒推送实时速率（宿主首页网速曲线数据源）。
func startTrafficPump() {
	go func() {
		ticker := time.NewTicker(time.Second)
		defer ticker.Stop()

		for range ticker.C {
			up, down := tunnel.Now()
			pushEvent(Event{
				Event:   "traffic",
				Payload: trafficMessage{Up: up, Down: down},
			})
		}
	}()
}

func parseLogLevel(s string) (log.LogLevel, bool) {
	switch strings.ToLower(strings.TrimSpace(s)) {
	case "silent":
		return log.SILENT, true
	case "debug":
		return log.DEBUG, true
	case "info":
		return log.INFO, true
	case "warning", "warn":
		return log.WARNING, true
	case "error":
		return log.ERROR, true
	}

	return log.INFO, false
}
