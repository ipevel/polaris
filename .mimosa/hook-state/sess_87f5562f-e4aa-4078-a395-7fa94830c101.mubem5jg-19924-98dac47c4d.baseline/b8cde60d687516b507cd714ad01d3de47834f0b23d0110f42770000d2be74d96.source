//go:build windows

package main

// config.* 方法：订阅装载/校验、覆写槽、age 密钥。
//
// 关键设计——config.load 的处理顺序：
//  1. 先跑完整的 Android 安全补丁链（cfa/native/config.UnmarshalAndPatch → process()：
//     清空 external-controller 与全部入站端口/listeners、重置 DNS 防劫持、
//     directDomains 白名单规则兜底、TUN 强制关闭）；
//  2. 再在其结果上叠加桌面端增补：重开 TUN（sing-tun + wintun 自建设备，需管理员权限，
//     Inet4Address 由 parseTun 自动从 fake-ip 段推导，见 vendored config.go:1672-1676）、
//     按需启动本地 HTTP 代理监听（供系统代理使用）。
//
// 安全加固面与 Android 完全一致；桌面差异显式、有序、可审计。

import (
	"encoding/json"
	"strings"
	"sync"

	"cfa/native/config"
	"cfa/native/proxy"

	C "github.com/metacubex/mihomo/constant"
	"github.com/metacubex/mihomo/hub"
	"github.com/metacubex/mihomo/log"
)

// lifecycleMu 串行化 config.load / core.reset / core.shutdown：
// proxy 监听与 hub.ApplyConfig 不承诺并发安全（T13 评审 P1）。
var lifecycleMu sync.Mutex

type tunParams struct {
	Enable      bool   `json:"enable"`
	Stack       string `json:"stack"` // gvisor | system | mixed，缺省 gvisor
	MTU         uint32 `json:"mtu"`   // 缺省沿用内核默认
	StrictRoute bool   `json:"strictRoute"`
}

type configLoadParams struct {
	Path        string    `json:"path"` // 含 config.yaml 的 profile 目录
	Tun         tunParams `json:"tun"`
	ProxyListen string    `json:"proxyListen"` // 如 "127.0.0.1:0"，空则不起本地代理
}

type configLoadResult struct {
	TunEnabled  bool   `json:"tunEnabled"`
	ProxyListen string `json:"proxyListen,omitempty"`
}

var proxyListenAddr string

func stopProxyListener() {
	proxy.Stop()
	proxyListenAddr = ""
}

func configLoad(params json.RawMessage) (any, error) {
	lifecycleMu.Lock()
	defer lifecycleMu.Unlock()

	var p configLoadParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	if p.Path == "" {
		return nil, errInvalid("path is required")
	}

	raw, err := config.UnmarshalAndPatch(p.Path)
	if err != nil {
		log.Errorln("[APP] config load %s: %v", p.Path, err)

		return nil, err
	}

	if p.Tun.Enable {
		raw.Tun.Enable = true
		raw.Tun.AutoRoute = true
		raw.Tun.AutoDetectInterface = true
		raw.Tun.DNSHijack = []string{"any:53"}
		raw.Tun.StrictRoute = p.Tun.StrictRoute

		if p.Tun.MTU > 0 {
			raw.Tun.MTU = p.Tun.MTU
		}

		if p.Tun.Stack != "" {
			if stack, ok := C.StackTypeMapping[strings.ToLower(p.Tun.Stack)]; ok {
				raw.Tun.Stack = stack
			}
		}
	}

	cfg, err := config.Parse(raw)
	if err != nil {
		log.Errorln("[APP] config parse %s: %v", p.Path, err)

		return nil, err
	}

	hub.ApplyConfig(cfg)

	// 本地代理监听（系统代理用）。失败时 TUN/配置已生效，
	// 返回错误由宿主决定降级重试（如关 TUN 再试），此处保证监听状态干净。
	stopProxyListener()

	if p.ProxyListen != "" {
		listenAt, err := proxy.Start(p.ProxyListen)
		if err != nil {
			return nil, err
		}

		proxyListenAddr = listenAt
	}

	return configLoadResult{
		TunEnabled:  raw.Tun.Enable, // 回传最终生效值（补丁链可能覆盖请求值）
		ProxyListen: proxyListenAddr,
	}, nil
}

// ---- 订阅拉取与校验 ----
// 与 Android 端 fetchAndValid 对应：阻塞式执行（含 60s 拉取超时），
// 过程状态经 fetchStatus 事件实时推送，结束另有 fetchDone 事件 + 最终响应。
// 注意：content:// URL（Android AssetManager 通道）在桌面端不可用，会返回错误。

type fetchParams struct {
	Path  string `json:"path"`
	URL   string `json:"url"`
	Force bool   `json:"force"`
	Token string `json:"token"` // 宿主生成，用于关联事件与响应
}

type fetchStatusPayload struct {
	Token  string          `json:"token"`
	Status json.RawMessage `json:"status"`
}

type fetchDonePayload struct {
	Token string `json:"token"`
	Error string `json:"error,omitempty"`
}

func configFetchAndValid(params json.RawMessage) (any, error) {
	var p fetchParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	if p.Path == "" || p.URL == "" {
		return nil, errInvalid("path and url are required")
	}

	if p.Token == "" {
		return nil, errInvalid("token is required")
	}

	err := config.FetchAndValid(p.Path, p.URL, p.Force, func(status string) {
		pushEvent(Event{
			Event: "fetchStatus",
			Payload: fetchStatusPayload{
				Token:  p.Token,
				Status: json.RawMessage(status),
			},
		})
	})

	pushEvent(Event{
		Event: "fetchDone",
		Payload: fetchDonePayload{
			Token: p.Token,
			Error: errText(err),
		},
	})

	if err != nil {
		return nil, err
	}

	return nil, nil
}

// ---- 覆写槽（persist / session）----

type overrideParams struct {
	Slot    int    `json:"slot"`
	Content string `json:"content"`
}

func configReadOverride(params json.RawMessage) (any, error) {
	var p overrideParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	return map[string]string{
		"content": config.ReadOverride(config.OverrideSlot(p.Slot)),
	}, nil
}

func configWriteOverride(params json.RawMessage) (any, error) {
	var p overrideParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	config.WriteOverride(config.OverrideSlot(p.Slot), p.Content)

	return nil, nil
}

func configClearOverride(params json.RawMessage) (any, error) {
	var p overrideParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	config.ClearOverride(config.OverrideSlot(p.Slot))

	return nil, nil
}

// ---- age 密钥（加密订阅）----

type ageKeyPair struct {
	SecretKey string `json:"secretKey"`
	PublicKey string `json:"publicKey"`
}

type secretKeysParams struct {
	Keys []string `json:"keys"`
}

func configSetAgeSecretKey(params json.RawMessage) (any, error) {
	var p secretKeysParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	// keys 缺省 = 清空密钥（对齐 Android 端 key==nil 分支）
	config.SetGlobalSecretKeys(p.Keys...)

	return nil, nil
}

func configGenX25519KeyPair(_ json.RawMessage) (any, error) {
	secret, public, err := config.GenX25519KeyPair()
	if err != nil {
		return nil, err
	}

	return ageKeyPair{SecretKey: secret, PublicKey: public}, nil
}

func configGenHybridKeyPair(_ json.RawMessage) (any, error) {
	secret, public, err := config.GenHybridKeyPair()
	if err != nil {
		return nil, err
	}

	return ageKeyPair{SecretKey: secret, PublicKey: public}, nil
}

func configToPublicKeys(params json.RawMessage) (any, error) {
	var p secretKeysParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	publics, err := config.ToPublicKeys(p.Keys...)
	if err != nil {
		return nil, err
	}

	return map[string]any{"publicKeys": publics}, nil
}

func configVeritySecretKeys(params json.RawMessage) (any, error) {
	var p secretKeysParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	return map[string]bool{"valid": config.VeritySecretKeys(p.Keys...) == nil}, nil
}

func configVerityPublicKeys(params json.RawMessage) (any, error) {
	var p secretKeysParams
	if err := decodeParams(params, &p); err != nil {
		return nil, err
	}

	return map[string]bool{"valid": config.VerityPublicKeys(p.Keys...) == nil}, nil
}

func init() {
	register("config.load", configLoad)
	register("config.fetchAndValid", configFetchAndValid)
	register("config.readOverride", configReadOverride)
	register("config.writeOverride", configWriteOverride)
	register("config.clearOverride", configClearOverride)
	register("config.setAgeSecretKey", configSetAgeSecretKey)
	register("config.genX25519KeyPair", configGenX25519KeyPair)
	register("config.genHybridKeyPair", configGenHybridKeyPair)
	register("config.toPublicKeys", configToPublicKeys)
	register("config.veritySecretKeys", configVeritySecretKeys)
	register("config.verityPublicKeys", configVerityPublicKeys)
}
