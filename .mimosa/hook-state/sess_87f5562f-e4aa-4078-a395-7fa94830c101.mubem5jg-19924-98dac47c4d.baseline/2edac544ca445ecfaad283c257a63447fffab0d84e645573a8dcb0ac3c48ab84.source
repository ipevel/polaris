package cc.polaris.desktop.panel.remote

import cc.polaris.desktop.panel.data.local.ApiUrlStore
import cc.polaris.desktop.panel.remote.config.EndpointSelector
import cc.polaris.desktop.panel.remote.config.FailoverConfig

/**
 * 桌面版远程配置桩（R7）：替代安卓 `com.slte.app.data.remote.config.RemoteConfig`。
 *
 * 安卓 RemoteConfig 承担两类职责，这里分别处理：
 * 1. **FailoverConfig / 面板地址转发**（本批网络栈真正用到的部分）——
 *    安卓实现里 `apiBaseUrl` 与 `apiCandidates` 本来就是只读
 *    `apiUrlStore.effectiveBaseUrl / currentUrl` 的透传（不内置、不兜底），
 *    桌面版保持同一语义，直接转发 [ApiUrlStore]；
 * 2. **远端配置拉取 / 探测 / 候选下发 / Crisp 客服 / 更新分发**——
 *    依赖 RemoteConfigStore/RemoteConfigProber/RemoteConfigParser 与
 *    BuildConfig 注入域名（RemoteConfigStore.kt / RemoteConfig.kt 不移植），
 *    全部返回空候选 / 零值（[apiBaseUrls] / [directDomains] / [crispWebsiteId]）。
 *
 * 使用处核对（grep 源码确认，批2 消费方仅 BackendAdapterFactory）：
 * - `remoteConfig` 作为 FailoverConfig：`apiBaseUrl`、`apiCandidates(primary)` → 已实现（转发语义与安卓一致）；
 * - `remoteConfig.endpointSelector` → 已提供（object 单例持有）；
 * - 其余使用处（SubscribeSourceImpl 用 apiBaseUrl、KernelConfig 用 directDomains/apiBaseUrl、
 *   AppModule/SlteApplication/UpdateViewModel 用 startFetch/startProbeLoop/dataFlow/data/refresh/updateApkUrl）
 *   属后续批次或 Android 专属，[apiBaseUrls]/[directDomains]/[crispWebsiteId] 已按空值签名备好；
 *   startFetch/startProbeLoop/dataFlow/refresh/updateApkUrl 暂无桌面对应（遗留缺口，见批2报告）。
 */
object DeskRemoteConfig : FailoverConfig {

    /**
     * 实际生效的 API 基地址：唯一来源是用户在登录页输入并保存的面板地址，
     * 未配置时为空串（网络层快速失败）。与安卓 RemoteConfig.apiBaseUrl 语义一致。
     */
    override val apiBaseUrl: String
        get() = ApiUrlStore.effectiveBaseUrl()

    /**
     * 仅以用户输入并保存的面板地址为准，不提供任何内置候选、不做兜底：
     * 未配置地址时返回空列表，由 ApiFailoverInterceptor 快速失败。
     * 与安卓 RemoteConfig.apiCandidates 语义一致。
     */
    override fun apiCandidates(primary: String): List<String> =
        ApiUrlStore.currentUrl?.let { listOf(it) } ?: emptyList()

    /** 与安卓 RemoteConfig.endpointSelector 同名同型（单实例，供 BackendAdapterFactory 构建 ApiFailoverInterceptor）。 */
    val endpointSelector: EndpointSelector = EndpointSelector()

    /** R7 桩：远端配置下发的候选基地址（安卓 RemoteConfigData.apiBaseUrls），桌面恒为空。 */
    fun apiBaseUrls(): List<String> = emptyList()

    /** R7 桩：远端配置下发的直连域名（安卓 RemoteConfigData.directDomains），桌面恒为空。 */
    fun directDomains(): List<String> = emptyList()

    /** R7 桩：Crisp 在线客服 websiteId（安卓 BuildConfig.CRISP_WEBSITE_ID），桌面无客服组件。 */
    fun crispWebsiteId(): String? = null
}
