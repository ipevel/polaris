package cc.polaris.desktop.platform

import java.io.FileInputStream
import java.security.MessageDigest

class CoreLaunchException(message: String) : Exception(message)

/**
 * core 拉起器：
 * - helper 可用（提权路径）：交由 SYSTEM 服务校验哈希白名单并拉起，TUN 可用；
 * - helper 不可用（非提权回退）：本地 ProcessBuilder 直启，宿主侧同样做 SHA-256
 *   校验（与 helper 同一白名单语义），TUN 不可用（UI 提示安装服务）。
 */
class CoreLauncher(
    private val coreExePath: String,
    private val expectedCoreSha256: Set<String>,
    private val helper: HelperClient?,
) {

    var directProcess: Process? = null
        private set

    /** 最近一次经 helper 拉起的 core pid（-1 = 未走 helper 路径）；供宿主兜底 stopCore。 */
    @Volatile
    var lastHelperPid: Long = -1
        private set

    /** 拉起 core 并返回 pid。 */
    fun launch(port: Int): Long {
        return if (helper != null) {
            helper.startCore(coreExePath, port).toLong().also { lastHelperPid = it }
        } else {
            launchDirect(port)
        }
    }

    /** 停止非提权直启的 core（提权路径经 helper.stopCore）。 */
    fun stopDirect() {
        directProcess?.destroyForcibly()
        directProcess = null
    }

    private fun launchDirect(port: Int): Long {
        verifyLocalHash()

        // core 以帧协议通信，stdout 仅日志：系统级丢弃，避免任何受管/裸线程
        val process = ProcessBuilder(coreExePath, "--port", port.toString())
            .redirectOutput(ProcessBuilder.Redirect.DISCARD)
            .redirectError(ProcessBuilder.Redirect.DISCARD)
            .start()

        return process.pid().also { directProcess = process }
    }

    private fun verifyLocalHash() {
        if (expectedCoreSha256.isEmpty()) {
            return // 白名单未配置（开发模式放行；发布版经 ldflags/配置注入）
        }

        val actual = fileSha256(coreExePath)
        if (actual !in expectedCoreSha256) {
            throw CoreLaunchException("core 哈希校验失败: $actual")
        }
    }

    private fun fileSha256(path: String): String {
        val md = MessageDigest.getInstance("SHA-256")

        FileInputStream(path).use { input ->
            val buf = ByteArray(64 * 1024)
            while (true) {
                val n = input.read(buf)
                if (n < 0) {
                    break
                }

                md.update(buf, 0, n)
            }
        }

        return md.digest().joinToString("") { "%02x".format(it) }
    }
}
