package cc.polaris.desktop.panel.data.local

import java.nio.file.AtomicMoveNotSupportedException
import java.nio.file.Files
import java.nio.file.Path
import java.nio.file.StandardCopyOption

/**
 * 面板本地文件存储公共设施（批2 A 项）。
 *
 * - 目录根与 desktop `Main.kt` 的 `appDataHome()` 同源：`%APPDATA%` 派生
 *   （缺失时回退 `user.home/AppData/Roaming`），面板数据固定在其下 `panel/` 子目录；
 * - 写入一律走 [writeTextAtomic]：同目录临时文件 + `ATOMIC_MOVE` 改名，
 *   不支持原子改名的文件系统回退普通替换，避免半截 JSON；
 * - 读取容忍缺失/损坏：返回 null 由调用方按默认值处理。
 */
internal object PanelStorage {

    private fun appDataHome(): Path {
        val appData = System.getenv("APPDATA")
            ?: (System.getProperty("user.home") + "/AppData/Roaming")

        return Path.of(appData, "Polaris")
    }

    fun panelDir(): Path = appDataHome().resolve("panel")

    fun readText(fileName: String): String? {
        val file = panelDir().resolve(fileName)
        if (!Files.exists(file)) return null
        return runCatching { Files.readString(file) }.getOrNull()
    }

    fun writeTextAtomic(
        fileName: String,
        content: String,
    ) {
        val dir = panelDir()
        Files.createDirectories(dir)
        val target = dir.resolve(fileName)
        val tmp = dir.resolve("$fileName.tmp-${System.nanoTime()}")
        try {
            Files.writeString(tmp, content)
            try {
                Files.move(tmp, target, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE)
            } catch (_: AtomicMoveNotSupportedException) {
                Files.move(tmp, target, StandardCopyOption.REPLACE_EXISTING)
            }
        } finally {
            runCatching { Files.deleteIfExists(tmp) }
        }
    }
}
