package cc.polaris.desktop.core

import cc.polaris.desktop.platform.CoreLauncher
import cc.polaris.desktop.platform.HelperClient
import cc.polaris.desktop.platform.SystemProxy
import cc.polaris.desktop.platform.Updater
import cc.polaris.desktop.rpc.CoreConnection
import cc.polaris.desktop.rpc.RpcEvent
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.Job
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.launch
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock
import kotlinx.coroutines.withContext
import kotlinx.coroutines.withTimeoutOrNull
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.buildJsonObject
import kotlinx.serialization.json.contentOrNull
import kotlinx.serialization.json.jsonObject
import kotlinx.serialization.json.jsonPrimitive
import kotlinx.serialization.json.put
import java.nio.file.Files
import java.nio.file.Path
import java.util.concurrent.atomic.AtomicLong

/** 实时速率样本（内核 traffic 事件，1s 间隔；首页曲线数据源）。 */
data class TrafficSample(val timeMs: Long, val up: Long, val down: Long)

/** 桌面端版本号：与 iss AppVersion / 更新清单比较共用此常量（单一来源）。 */
const val DESKTOP_VERSION = "0.2.0"

/**
 * 桌面核心编排器：helper 探测 → 反向连接 → core.init → config.load。
 * 状态机单源（_status）；全部阻塞段在 IO 调度器（T13 评审：start 不再占用调用方线程）；
 * 日志事件收集协程随连接关闭而取消（不泄漏）。
 */
class CoreManager(
    val appHome: Path,
    private val coreExe: Path,
    private val coreSha256Whitelist: Set<String>,
    private val helperConfig: HelperConfig?,
) {

    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
    private val startStop = Mutex()

    /** UI 可设置的 TUN 配置；start() 使用当前值。 */
    @Volatile
    var tunConfig: TunConfig = TunConfig()

    private val _status = MutableStateFlow(CoreStatus())
    val status: StateFlow<CoreStatus> = _status.asStateFlow()

    /** 内核日志环形缓冲（事件 log → 追加；上限 500 行；行带自增 id 供列表稳定 key）。 */
    private val _logLines = MutableStateFlow<List<LogLine>>(emptyList())
    val logLines: StateFlow<List<LogLine>> = _logLines.asStateFlow()

    /** 实时速率环形缓冲（120 点 ≈ 2 分钟），traffic 事件驱动。 */
    private val _traffic = MutableStateFlow<List<TrafficSample>>(emptyList())
    val traffic: StateFlow<List<TrafficSample>> = _traffic.asStateFlow()

    /** 会话累计流量（独立于环形缓冲，不随滚动丢失；T15 评审 P1-5）。 */
    @Volatile
    var sessionTotalUp: Long = 0L
        private set

    @Volatile
    var sessionTotalDown: Long = 0L
        private set

    private val logSeq = AtomicLong(0)
    private var connection: CoreConnection? = null
    private var launcher: CoreLauncher? = null
    private var helper: HelperClient? = null
    private var logCollector: Job? = null

    init {
        Files.createDirectories(appHome.resolve("profiles"))
    }

    /** 默认 profile 目录（单配置；收敛硬编码，T15 评审 P1-8）。 */
    val defaultProfileDir: Path
        get() = appHome.resolve("profiles/default")

    /** 清空内核日志视图。 */
    fun clearLogs() {
        _logLines.value = emptyList()
    }

    /** 本地代理固定监听端口（用户要求 7890；系统代理与此联动）。 */
    val PROXY_PORT: Int = 7890

    /** 拉起并连接内核。已完成时幂等返回。 */
    suspend fun start(profileDir: Path) {
        startStop.withLock {
            when (_status.value.state) {
                ConnState.CONNECTING, ConnState.CONNECTED -> return
                ConnState.DISCONNECTING -> throw IllegalStateException("正在停止，稍后重试")
                ConnState.DISCONNECTED -> Unit
            }

            setStatus { copy(state = ConnState.CONNECTING, error = null) }

            try {
                withContext(Dispatchers.IO) { startBlocking(profileDir) }
            } catch (e: Exception) {
                cleanupCore()
                setStatus { copy(state = ConnState.DISCONNECTED, error = e.message ?: "启动失败") }
            }
        }
    }

    private suspend fun startBlocking(profileDir: Path) {
        // 0. 清理孤儿内核：上次崩溃/强杀遗留的 PolarisCore 会占住 7890 代理端口，
        //    导致本实例 bind 失败（「Only one usage of each socket address」）。
        //    此刻本实例内核尚未启动，命中的只可能是孤儿。
        withContext(Dispatchers.IO) {
            ProcessHandle.allProcesses().filter { proc ->
                proc.info().command().orElse("").contains("PolarisCore", ignoreCase = true)
            }.forEach { proc ->
                runCatching {
                    proc.destroyForcibly()
                    appendLog("已清理孤儿内核进程 pid=${proc.pid()}")
                }
            }
        }

        // 1. helper 探测：服务不可用即非提权回退（TUN 将不可用）
        val hc = probeHelper()
        helper = hc

        // 2. 监听随机回环端口并等待 core 反向连接
        val conn = CoreConnection()
        val lc = CoreLauncher(coreExe.toString(), coreSha256Whitelist, hc)
        launcher = lc

        logCollector = scope.launch {
            conn.events.collect { event -> onEvent(event) }
        }

        conn.awaitCore { port -> lc.launch(port) }
        connection = conn

        // 3. core.init
        val init = conn.request(
            "core.init",
            buildJsonObject {
                put("home", appHome.toString())
                put("versionName", "desktop")
                put("gitVersion", "desktop-$DESKTOP_VERSION")
                put("platformVersion", 30)
            },
        )
        val version = init?.jsonObject?.get("version")?.jsonPrimitive?.contentOrNull

        // 4. config.load：完整 Android 安全补丁链 + 桌面增补（TUN/本地代理）。
        //    首次使用（订阅尚未拉取）时 config.yaml 不存在：跳过加载，保持 CONNECTED，
        //    由「配置」页 config.fetchAndValid 拉取订阅并生效（打破「先有内核再有配置」死锁）。
        val profileConfig = profileDir.resolve("config.yaml")
        var proxyListen: String? = null
        var tunEnabled: Boolean? = null
        var loaded = false

        if (java.nio.file.Files.exists(profileConfig)) {
            val resp = conn.request(
                "config.load",
                buildJsonObject {
                    put("path", profileDir.toString())
                    put("tun", tunConfig.toJson())
                    put("proxyListen", "127.0.0.1:$PROXY_PORT")
                },
            )
            val data = resp?.jsonObject
            proxyListen = data?.get("proxyListen")?.jsonPrimitive?.contentOrNull
            tunEnabled = data?.get("tunEnabled")?.jsonPrimitive?.contentOrNull?.toBooleanStrictOrNull()
            loaded = true
        }

        setStatus {
            copy(
                state = ConnState.CONNECTED,
                profileLoaded = loaded,
                proxyListen = proxyListen,
                tunEnabled = tunEnabled ?: tunConfig.enable,
                coreVersion = version,
                elevated = hc != null,
            )
        }

        // 连接即接管流量：订阅已生效时自动开启系统代理（用户反馈「连上但上不了网」根因）
        if (loaded) {
            withContext(Dispatchers.IO) {
                runCatching { SystemProxy.enable(PROXY_PORT) }
            }
        }
    }

    /** 停止内核并断开。未连接时幂等返回。 */
    suspend fun stop() {
        startStop.withLock {
            when (_status.value.state) {
                ConnState.CONNECTED -> setStatus { copy(state = ConnState.DISCONNECTING) }
                ConnState.DISCONNECTED, ConnState.DISCONNECTING -> return
                ConnState.CONNECTING -> throw IllegalStateException("正在启动，稍后重试")
            }

            try {
                withContext(Dispatchers.IO) {
                    // shutdown 给短超时：失败由 cleanup 兜底杀进程
                    withTimeoutOrNull(5_000) {
                        runCatching { connection?.request("core.shutdown") }
                    }
                }
            } catch (_: Exception) {
            }

            cleanupCore()
            setStatus {
                copy(
                    state = ConnState.DISCONNECTED,
                    proxyListen = null,
                    tunEnabled = false,
                    coreVersion = null,
                    elevated = false,
                )
            }
        }
    }

    /** 拉取/校验订阅；进度经事件（fetchStatus/fetchDone）体现，由日志与后续 UI 通道展示。 */
    suspend fun fetchAndValid(profileDir: Path, url: String, force: Boolean): String? {
        val conn = connection ?: throw IllegalStateException("core 未连接")

        val token = System.nanoTime().toString()
        conn.request(
            "config.fetchAndValid",
            buildJsonObject {
                put("path", profileDir.toString())
                put("url", url)
                put("force", force)
                put("token", token)
            },
        )

        return null // fetchDone 事件由 UI 层收集展示
    }

    /** 通用 RPC 出口（T15f/g：代理组/连接页直接调用内核方法）。 */
    suspend fun rpc(method: String, params: JsonObject? = null): kotlinx.serialization.json.JsonElement? {
        val conn = connection ?: throw IllegalStateException("core 未连接")

        return conn.request(method, params)
    }

    /** 订阅生效后重载配置：回读本地代理端口 / TUN 状态（fetchAndValid 不返回这些）。 */
    suspend fun reloadConfig(profileDir: Path) {
        val conn = connection ?: return

        val loaded = withContext(Dispatchers.IO) {
            conn.request(
                "config.load",
                buildJsonObject {
                    put("path", profileDir.toString())
                    put("tun", tunConfig.toJson())
                    put("proxyListen", "127.0.0.1:$PROXY_PORT")
                },
            )
        }?.jsonObject

        val old = _status.value
        setStatus {
            copy(
                profileLoaded = true,
                proxyListen = loaded?.get("proxyListen")?.jsonPrimitive?.contentOrNull,
                tunEnabled = loaded?.get("tunEnabled")?.jsonPrimitive?.contentOrNull?.toBooleanStrictOrNull()
                    ?: old.tunEnabled,
            )
        }
    }

    /**
     * 检查并安装自更新（helper 侧复核源域白名单与哈希；无 helper 时拒绝自动更新）。
     * 返回给 UI 的反馈文本。
     */
    suspend fun checkForUpdate(manifestUrl: String): String = withContext(Dispatchers.IO) {
        val updater = Updater { helper }
        val manifest = updater.check(currentVersion = DESKTOP_VERSION, manifestUrl)
            ?: return@withContext "已是最新版本"

        val installer = updater.download(manifest)
        try {
            updater.install(manifest, installer)
            "已发起更新安装（${manifest.version}），安装器将在后台完成"
        } finally {
            runCatching { Files.deleteIfExists(installer) } // 可能仍被安装器占用：删除失败降级为警告
        }
    }

    fun appendLog(line: String) {
        val next = _logLines.value + LogLine(logSeq.incrementAndGet(), line)
        _logLines.value = if (next.size > 500) next.takeLast(500) else next
    }

    private suspend fun probeHelper(): HelperClient? {
        val cfg = helperConfig ?: return null

        val client = HelperClient(cfg.pipeName, cfg.authKeyHex)

        return try {
            client.status()
            client
        } catch (_: Exception) {
            runCatching { client.close() } // 探测失败也必须释放管道句柄
            null
        }
    }

    private fun onEvent(event: RpcEvent) {
        when (event.event) {
            "traffic" -> {
                val payload = event.payload
                if (payload is JsonObject) {
                    val up = payload["up"]?.jsonPrimitive?.contentOrNull?.toLongOrNull() ?: 0L
                    val down = payload["down"]?.jsonPrimitive?.contentOrNull?.toLongOrNull() ?: 0L
                    synchronized(this) {
                        sessionTotalUp += up
                        sessionTotalDown += down
                    }
                    val next = _traffic.value + TrafficSample(System.currentTimeMillis(), up, down)
                    _traffic.value = if (next.size > 120) next.takeLast(120) else next
                }
            }

            "log" -> onLogEvent(event)

            else -> appendLog("[${event.event}] ${event.payload?.toString()?.take(200) ?: ""}")
        }
    }

    private fun onLogEvent(event: RpcEvent) {
        val payload = event.payload
        val line = when (payload) {
            is JsonObject -> payload["message"]?.jsonPrimitive?.contentOrNull
                ?: payload["msg"]?.jsonPrimitive?.contentOrNull
                ?: payload.toString().take(200)

            else -> payload?.toString()?.take(200) ?: ""
        }
        appendLog(line)
    }

    private suspend fun cleanupCore() {
        // helper 路径的 core 兜底杀（T13 评审 P0：pid 未记录导致 SYSTEM 孤儿进程）
        val lc = launcher
        val hc = helper

        if (hc != null && lc != null) {
            val pid = lc.lastHelperPid
            if (pid > 0) {
                runCatching { hc.stopCore(pid.toInt()) }
            }
        }

        try {
            connection?.close()
        } catch (_: Exception) {
        }

        try {
            launcher?.stopDirect()
        } catch (_: Exception) {
        }

        try {
            helper?.close()
        } catch (_: Exception) {
        }

        logCollector?.cancel()
        logCollector = null
        connection = null
        launcher = null
        helper = null
        _traffic.value = emptyList()
        sessionTotalUp = 0L
        sessionTotalDown = 0L
        setStatus { copy(profileLoaded = false, proxyListen = null) }

        // 断开即还原系统代理（与连接成功时的自动开启配对）
        withContext(Dispatchers.IO) {
            runCatching { SystemProxy.disable() }
        }
    }

    private inline fun setStatus(transform: CoreStatus.() -> CoreStatus) {
        _status.value = transform(_status.value)
    }
}
