package cc.polaris.desktop.platform

/**
 * WinINet 系统代理（注册表方式，v2rayN 同款语义）：
 * ProxyEnable / ProxyServer / ProxyOverride 三键 + <local> 覆盖。
 * 说明：注册表写入对 Chrome/Edge 等轮询型应用即时生效；传统 WinINet 应用
 * 需要 InternetSetOption(INTERNET_OPTION_SETTINGS_CHANGED) 广播刷新，
 * 该调用需 JNA/FFM，待 T11 打包评估是否引入（当前注释留位）。
 */
object SystemProxy {

    private const val KEY = "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings"

    fun enable(port: Int): Boolean {
        val okServer = regAdd("ProxyServer", "127.0.0.1:$port", "REG_SZ")
        val okEnable = regAdd("ProxyEnable", "1", "REG_DWORD")
        val okOverride = regAdd(
            "ProxyOverride",
            "localhost;127.*;10.*;172.16.*;172.17.*;172.18.*;172.19.*;172.20.*;172.21.*;172.22.*;172.23.*;172.24.*;172.25.*;172.26.*;172.27.*;172.28.*;172.29.*;172.30.*;172.31.*;192.168.*;<local>",
            "REG_SZ",
        )

        return okServer && okEnable && okOverride
    }

    fun disable(): Boolean = regAdd("ProxyEnable", "0", "REG_DWORD")

    /** 系统代理开启且指向本地时返回端口，否则 null。 */
    fun currentLocalPort(): Int? {
        val enabled = regQuery("ProxyEnable")?.trim() == "0x1"
        if (!enabled) {
            return null
        }

        val server = regQuery("ProxyServer") ?: return null
        return server.substringAfterLast(':').toIntOrNull()
    }

    private fun regAdd(name: String, value: String, type: String): Boolean =
        exec("reg", "add", KEY, "/v", name, "/t", type, "/d", value, "/f")

    private fun regQuery(name: String): String? {
        try {
            val process = ProcessBuilder("reg", "query", KEY, "/v", name)
                .redirectErrorStream(true)
                .start()
            val output = process.inputStream.readBytes().toString(java.nio.charset.Charset.defaultCharset())
            process.waitFor()

            if (process.exitValue() != 0) {
                return null
            }

            return output.lineSequence()
                .firstOrNull { it.contains(name, ignoreCase = true) }
                ?.substringAfterLast("REG_SZ")
                ?.substringAfterLast("REG_DWORD")
                ?.trim()
        } catch (_: Exception) {
            return null
        }
    }

    private fun exec(vararg command: String): Boolean = try {
        ProcessBuilder(*command).start().waitFor() == 0
    } catch (_: Exception) {
        false
    }
}
