package cc.polaris.desktop.panel.repository

import cc.polaris.desktop.panel.data.local.SessionStore
import cc.polaris.desktop.panel.domain.model.ServerNode
import cc.polaris.desktop.panel.remote.DeskEnv
import cc.polaris.desktop.panel.remote.DeskLog
import cc.polaris.desktop.panel.remote.api.AuthApi

/**
 * 缓存有效期策略（批3）：移植自安卓 `data/repository/ServerRepository.kt` 内的
 * `internal object CachePolicy`，同包共享（SubscribeRepository 亦引用），逐行照抄。
 */
internal object CachePolicy {
    const val SUBSCRIBE_INFO_TTL_MS = 30_000L

    const val USER_INFO_TTL_MS = 30_000L

    const val SERVER_NODES_TTL_MS = 30 * 60_000L

    fun isFresh(
        cachedAtMs: Long,
        nowMs: Long,
        ttlMs: Long,
    ): Boolean = cachedAtMs > 0L && nowMs - cachedAtMs < ttlMs
}

/**
 * 节点 Repository（批3）：移植自安卓 `data/repository/ServerRepository.kt`。
 *
 * 桌面适配：
 * - `@Singleton class + @Inject 构造` → 去注解 class，构造参数显式传入；
 * - `BuildConfig.DEBUG` → `DeskEnv.DEBUG`（R2）；AppLog/sanitizeLog → DeskLog/DeskLog.sanitize（R1）；
 *   其余（缓存 TTL、失败回退缓存、invalidateCache）逐行照抄。
 */
class ServerRepository(
    private val authApi: AuthApi,
    private val sessionStore: SessionStore,
) {

    suspend fun fetchServers(force: Boolean = false): Result<List<ServerNode>> = runApi {
        val cached = sessionStore.getServerNodes()
        val fetchedAt = sessionStore.getServerNodesFetchedAt()
        if (!force && cached != null && CachePolicy.isFresh(fetchedAt, System.currentTimeMillis(), CachePolicy.SERVER_NODES_TTL_MS)) {
            debugLog("fetchServers: 缓存未过期，直接返回 ${cached.size} 个节点")
            return@runApi cached
        }

        debugLog("fetchServers: 开始请求 API...")
        val nodes = authApi.fetchServers()
        debugLog("fetchServers: 返回 ${nodes.size} 个节点")
        if (nodes.isNotEmpty()) {
            sessionStore.saveServerNodes(nodes)
        }
        nodes
    }.recoverCatching { e ->
        if (force) throw e
        val cached = sessionStore.getServerNodes()
        if (cached != null) {
            DeskLog.w("Polaris-Repo", "fetchServers: 网络失败,使用本地缓存 ${cached.size} 个节点: ${DeskLog.sanitize(e.message ?: "")}")
            cached
        } else {
            throw e
        }
    }

    fun getCachedServers(): List<ServerNode>? = sessionStore.getServerNodes()

    fun invalidateCache() {
        sessionStore.clearServerNodes()
    }

    private fun debugLog(message: String) {
        if (DeskEnv.DEBUG) {
            DeskLog.d("Polaris-Repo", message)
        }
    }
}
