package cc.polaris.desktop.panel.remote

import java.io.IOException
import kotlinx.serialization.SerializationException
import kotlinx.serialization.json.Json
import kotlinx.serialization.json.JsonArray
import kotlinx.serialization.json.JsonElement
import kotlinx.serialization.json.JsonNull
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.JsonPrimitive
import okhttp3.FormBody
import okhttp3.Interceptor
import okhttp3.Request
import okhttp3.Response
import okio.Buffer

/**
 * 把 JSON 请求体改写成 `application/x-www-form-urlencoded`（批2 D 项）。
 * 移植自安卓 `data/remote/FormUrlEncodedInterceptor.kt`；桌面适配仅 AppLog→DeskLog、
 * sanitizeLog→DeskLog.sanitize（R1），其余逐行照抄。
 *
 * **为什么需要**：部分 V2Board / Xboard 面板部署只解析表单编码，
 * `Content-Type: application/json` 的请求体在进入后端校验前就被丢弃，服务端读到的
 * 字段全为空 → 直接 `422 {"message":"邮箱不能为空 (and 1 more error)"}`，
 * 与账号密码是否正确无关，登录必然失败（客户端此前只会把它显示成「邮箱或密码错误」）。
 * 面板自带的 Xboard 主题前端同样只发表单编码（axios 对 post/put/patch 强制改写），
 * 所以这类部署用官方前端测不出来。
 *
 * **转换规则**（在序列化之后的 wire JSON 上做，`@SerialName` 已是最终字段名）：
 * - 只处理 POST / PUT / PATCH 且 `Content-Type` 为 JSON 的请求，其余原样透传；
 * - JSON 对象按原有键序展开为表单字段；嵌套对象 / 数组用 Laravel 的 `key[sub]`、
 *   `key[0]` 语法，`$request->input('key')` 的取值语义不变；
 * - 值为 `null` 的字段直接省略——与 JSON 里该字段缺省等价，也能避开
 *   「空字符串 vs null」对 `nullable` 规则的差异；
 * - 空体、非对象 JSON（数组 / 标量）、非 JSON 体、一次性（one-shot / duplex）请求体
 *   一律原样透传，避免误伤面板之外或流式的接口。
 */
class FormUrlEncodedInterceptor : Interceptor {

    override fun intercept(chain: Interceptor.Chain): Response {
        val request = chain.request()
        val converted = toFormRequest(request) ?: return chain.proceed(request)
        return chain.proceed(converted)
    }

    private fun toFormRequest(request: Request): Request? {
        if (request.method !in FORM_METHODS) return null

        val body = request.body ?: return null
        if (body.isOneShot() || body.isDuplex()) return null

        val contentType = body.contentType() ?: return null
        if (!contentType.isJson()) return null

        val text =
            try {
                val buffer = Buffer()
                body.writeTo(buffer)
                buffer.readUtf8()
            } catch (e: IOException) {
                DeskLog.w("Polaris-Api", "FormUrlEncoded: 读取请求体失败，保持原样: ${DeskLog.sanitize(e.message ?: "")}")
                return null
            }
        if (text.isBlank()) return null

        val root =
            try {
                Json.parseToJsonElement(text)
            } catch (e: SerializationException) {
                DeskLog.w("Polaris-Api", "FormUrlEncoded: 请求体不是合法 JSON，保持原样: ${DeskLog.sanitize(e.message ?: "")}")
                return null
            }
        val json = root as? JsonObject
        if (json == null) {
            DeskLog.w("Polaris-Api", "FormUrlEncoded: 请求体不是 JSON 对象，保持原样: ${request.url.encodedPath}")
            return null
        }

        val form = FormBody.Builder()
        json.forEach { (key, value) -> append(form, key, value) }
        return request.newBuilder().method(request.method, form.build()).build()
    }

    private fun append(
        form: FormBody.Builder,
        key: String,
        element: JsonElement,
    ) {
        when (element) {
            is JsonObject -> element.forEach { (childKey, child) -> append(form, "$key[$childKey]", child) }
            is JsonArray -> element.forEachIndexed { index, child -> append(form, "$key[$index]", child) }
            // JsonNull 也是 JsonPrimitive 的子类，必须先判空再判标量
            is JsonNull -> Unit
            is JsonPrimitive -> form.add(key, element.content)
        }
    }

    private companion object {

        val FORM_METHODS = setOf("POST", "PUT", "PATCH")
    }
}

private fun okhttp3.MediaType.isJson(): Boolean = type == "application" && (subtype == "json" || subtype.endsWith("+json"))
