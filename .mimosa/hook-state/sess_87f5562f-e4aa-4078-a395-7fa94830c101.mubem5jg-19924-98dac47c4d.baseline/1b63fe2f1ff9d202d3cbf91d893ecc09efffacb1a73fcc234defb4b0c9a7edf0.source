package cc.polaris.desktop.core

import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.buildJsonObject
import kotlinx.serialization.json.put

/** 连接状态机：单源 MutableStateFlow，UI 只收集不直改。 */
enum class ConnState {
    DISCONNECTED,
    CONNECTING,
    CONNECTED,
    DISCONNECTING,
}

/** 桌面 TUN 参数（经 config.load 传给 Go 内核）。 */
data class TunConfig(
    // 默认关闭（用户要求：虚拟网卡默认不开启；需要时在首页/更多页手动打开）
    val enable: Boolean = false,
    val stack: String = "gvisor",
    val mtu: Int = 9000,
    val strictRoute: Boolean = false,
) {
    fun toJson(): JsonObject = buildJsonObject {
        put("enable", enable)
        put("stack", stack)
        put("mtu", mtu)
        put("strictRoute", strictRoute)
    }
}

/** UI 可观察的核心运行状态。 */
data class CoreStatus(
    val state: ConnState = ConnState.DISCONNECTED,
    /** 内核进程已反向连接（不代表代理可用：首次使用时订阅可能尚未生效）。 */
    val profileLoaded: Boolean = false,
    val proxyListen: String? = null,
    val tunEnabled: Boolean = false,
    val coreVersion: String? = null,
    val elevated: Boolean = false,
    val error: String? = null,
)

/** helper 服务的本地配置（安装期生成；密钥待 T9 接入 DPAPI 加密）。 */
@kotlinx.serialization.Serializable
data class HelperConfig(
    val pipeName: String,
    val authKeyHex: String,
)

/** 日志行：id 单调自增，作为 LazyColumn 稳定 key（对应评审 P0-3 重复 key 教训）。 */
data class LogLine(
    val id: Long,
    val text: String,
)
