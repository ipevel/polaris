name: 北辰 Polaris CI

on:
  push:
    branches: [main, master]
  pull_request:

permissions:
  contents: read

jobs:
  quality:
    name: 质量门禁（test + ktlint + lint）
    runs-on: ubuntu-latest

    env:
      POLARIS_USE_MIRROR: 'false'
      POLARIS_RELEASE_STORE_FILE: ${{ github.workspace }}/ci-throwaway.keystore
      POLARIS_RELEASE_STORE_PASSWORD: ci-throwaway
      POLARIS_RELEASE_KEY_ALIAS: ci-throwaway
      POLARIS_RELEASE_KEY_PASSWORD: ci-throwaway
    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 安装 JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: 配置 Gradle 缓存

        uses: gradle/actions/setup-gradle@v4
        with:
          cache-read-only: ${{ github.event_name == 'pull_request' }}

      - name: 安装 Android SDK / NDK

        run: |
          set -e
          SDKMANAGER="$(command -v sdkmanager || echo "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager")"
          test -x "$SDKMANAGER" || { echo "::error::找不到 sdkmanager（ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT）"; exit 1; }
          yes | "$SDKMANAGER" --licenses >/dev/null 2>&1 || true
          "$SDKMANAGER" "platforms;android-36" "build-tools;36.0.0" "ndk;28.2.13676358"
          "$SDKMANAGER" "cmake;3.22.1" || echo "::warning::cmake 预装失败，交由 AGP 自动下载"
          ls "$ANDROID_SDK_ROOT/cmake" 2>/dev/null || echo "SDK 内暂无可用的 cmake"

      - name: 生成 CI 一次性签名（lint 会分析 release 变体，必须存在）
        run: |
          set -e
          keytool -genkeypair -v \
            -keystore "$POLARIS_RELEASE_STORE_FILE" \
            -alias ci-throwaway -keyalg RSA -keysize 2048 -validity 1 \
            -storepass ci-throwaway -keypass ci-throwaway \
            -dname "CN=CI-Throwaway, OU=CI, O=CI, C=CN"

      - name: 内核产物完整性校验（SHA-256）
        run: |
          set -o pipefail
          ./gradlew :app:verifyKernelBinary 2>&1 | tee -a ci-failure.log

      - name: 编译 + 单元测试
        run: |
          chmod +x gradlew
          set -o pipefail
          ./gradlew :app:assembleDebug :app:testDebugUnitTest 2>&1 | tee -a ci-failure.log

      - name: 仪器化测试编译检查

        run: |
          set -o pipefail
          ./gradlew :app:assembleDebugAndroidTest 2>&1 | tee -a ci-failure.log

      - name: Release 混淆路径校验
        run: |
          set -o pipefail
          ./gradlew :app:minifyReleaseWithR8 :app:verifyReleaseApiSurvivors 2>&1 | tee -a ci-failure.log

      - name: ktlint + Android Lint
        run: |
          set -o pipefail
          ./gradlew :app:ktlintCheck :app:lintDebug 2>&1 | tee -a ci-failure.log

          if rg -n 'Icons\.(AutoMirrored\.)?(Outlined|Rounded|Filled|Sharp|TwoTone)\.' \
               app/src/main/java --glob '!**/ui/theme/SlteIcons.kt'; then
            echo "::error::页面出现裸 Icons.* 引用，请改为 SlteIcons.*（UI-GUIDELINES §3.4）"
            exit 1
          fi

      - name: 上传检查报告（失败时）
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: Polaris-CI-reports
          path: |
            ci-failure.log
            app/build/reports/tests/**
            app/build/reports/ktlint/**
            app/build/reports/lint-results-debug.html
          if-no-files-found: ignore
          retention-days: 30
