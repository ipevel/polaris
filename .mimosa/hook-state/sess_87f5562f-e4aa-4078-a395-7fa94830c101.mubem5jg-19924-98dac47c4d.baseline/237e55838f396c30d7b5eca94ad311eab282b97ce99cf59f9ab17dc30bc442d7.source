package cc.polaris.desktop.panel.utils

import cc.polaris.desktop.panel.remote.ApiException

/**
 * 错误文案映射（批2 F 项）：移植自安卓 `utils/ErrorMessages.kt`。
 *
 * 桌面适配（R3）：安卓版返回 `R.string` 资源 ID（Int），桌面版直接返回中文字符串；
 * 文案逐条抄自 `app/src/main/res/values/strings.xml` 同名资源（默认 values 即中文）。
 * `ApiException.stringResId` 在桌面为 `String?`（衔接点改动，见 ApiException.kt 注释）：
 * 适配器抛出的带文案异常直接透传，否则按后端 message 关键词映射本地文案。
 */
object ErrorMessages {

    private const val ERROR_NETWORK = "请求失败"
    private const val ERROR_ORDER_FAILED = "订单操作失败"
    private const val ERROR_SERVER_LOAD = "加载服务器列表失败"

    fun forLogin(e: Throwable?): String = when (e) {
        is ApiException -> e.stringResId ?: mapLoginError(e.message)
        else -> ERROR_NETWORK
    }

    fun forRegister(e: Throwable?): String = when (e) {
        is ApiException -> e.stringResId ?: mapRegisterError(e.message)
        else -> ERROR_NETWORK
    }

    fun forForgot(e: Throwable?): String = when (e) {
        is ApiException -> e.stringResId ?: mapForgotError(e.message)
        else -> ERROR_NETWORK
    }

    fun forSendCode(e: Throwable?): String = when (e) {
        is ApiException -> e.stringResId ?: mapSendCodeError(e.message)
        else -> ERROR_NETWORK
    }

    fun forOrder(e: Throwable?): String = when (e) {
        is ApiException -> e.stringResId ?: mapOrderError(e.message)
        else -> ERROR_ORDER_FAILED
    }

    fun forSubscribe(e: Throwable?): String = when (e) {
        is ApiException -> e.stringResId ?: mapSubscribeError(e.message)
        else -> ERROR_NETWORK
    }

    fun forServer(e: Throwable?): String = when (e) {
        is ApiException -> e.stringResId ?: mapServerError(e.message)
        else -> ERROR_SERVER_LOAD
    }

    fun mapLoginError(backendMessage: String): String = when {
        backendMessage.contains("不存在", ignoreCase = true) ||
            backendMessage.contains("not found", ignoreCase = true) ||
            backendMessage.contains("未注册", ignoreCase = true) ||
            backendMessage.contains("not registered", ignoreCase = true) ->
            "该邮箱未注册" // R.string.error_login_not_found

        backendMessage.contains("密码", ignoreCase = true) ||
            backendMessage.contains("password", ignoreCase = true) ||
            backendMessage.contains("账号", ignoreCase = true) ||
            backendMessage.contains("account", ignoreCase = true) ||
            backendMessage.contains("邮箱", ignoreCase = true) ||
            backendMessage.contains("email", ignoreCase = true) ->
            "邮箱或密码错误" // R.string.error_login_invalid

        else -> "登录失败" // R.string.error_login_failed
    }

    fun mapRegisterError(backendMessage: String): String = when {
        backendMessage.contains("验证码", ignoreCase = true) ||
            backendMessage.contains("code", ignoreCase = true) ||
            backendMessage.contains("verification", ignoreCase = true) ->
            "请输入验证码" // R.string.error_code_required

        else -> "注册失败重试" // R.string.error_register_failed
    }

    fun mapForgotError(backendMessage: String): String = when {
        backendMessage.contains("验证码", ignoreCase = true) ||
            backendMessage.contains("code", ignoreCase = true) ||
            backendMessage.contains("verification", ignoreCase = true) ->
            "请输入验证码" // R.string.error_code_required

        else -> "重置失败重试" // R.string.error_forgot_failed
    }

    fun mapSendCodeError(backendMessage: String): String = "验证码发送失败" // R.string.error_email_send_failed

    fun isPendingOrderMessage(backendMessage: String?): Boolean = backendMessage != null &&
        (
            backendMessage.contains("未完成", ignoreCase = true) ||
                backendMessage.contains("未支付", ignoreCase = true) ||
                backendMessage.contains("pending", ignoreCase = true) ||
                backendMessage.contains("unpaid", ignoreCase = true)
            )

    fun mapOrderError(backendMessage: String?): String = when {
        backendMessage == null -> ERROR_ORDER_FAILED

        isPendingOrderMessage(backendMessage) ->
            "您有一个未完成的订单" // R.string.purchase_existing_order_message

        backendMessage.contains("优惠", ignoreCase = true) ||
            backendMessage.contains("coupon", ignoreCase = true) ->
            "优惠券无效或已过期" // R.string.error_coupon_invalid

        backendMessage.contains("订单", ignoreCase = true) ||
            backendMessage.contains("order", ignoreCase = true) -> ERROR_ORDER_FAILED

        else -> ERROR_ORDER_FAILED
    }

    fun mapSubscribeError(backendMessage: String?): String = when {
        backendMessage == null ->
            "获取订阅信息失败" // R.string.api_error_subscribe_info

        backendMessage.contains("网络", ignoreCase = true) ||
            backendMessage.contains("network", ignoreCase = true) ||
            backendMessage.contains("连接", ignoreCase = true) -> ERROR_NETWORK

        else -> "获取订阅信息失败" // R.string.api_error_subscribe_info
    }

    fun mapServerError(backendMessage: String?): String = ERROR_SERVER_LOAD

    /**
     * 礼品卡兑换失败文案映射：识别后端常见错误描述转本地化提示；
     * 未识别返回 null（调用方决定透传后端原文还是兜底文案）。
     * 方法名保持安卓原名 `giftCardMessageRes`，返回类型由 Int?（资源 ID）改为 String?（文案）。
     */
    fun giftCardMessageRes(backendMessage: String?): String? {
        val message = backendMessage ?: return null
        return when {
            message.contains("不存在", ignoreCase = true) ||
                message.contains("无效", ignoreCase = true) ||
                message.contains("已过期", ignoreCase = true) ||
                message.contains("已使用", ignoreCase = true) ||
                message.contains("已兑换", ignoreCase = true) ||
                message.contains("not found", ignoreCase = true) ||
                message.contains("invalid", ignoreCase = true) ||
                message.contains("expired", ignoreCase = true) ||
                message.contains("used", ignoreCase = true) ||
                message.contains("redeemed", ignoreCase = true) ->
                "兑换码无效或已过期" // R.string.error_gift_card_invalid

            else -> null
        }
    }

    fun networkError(): String = ERROR_NETWORK
}
