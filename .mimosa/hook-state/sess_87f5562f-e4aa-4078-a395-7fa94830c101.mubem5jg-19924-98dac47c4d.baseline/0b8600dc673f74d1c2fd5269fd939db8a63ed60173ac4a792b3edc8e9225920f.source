//go:build windows

// Windows 平台占位实现。
//
// 本包原有的 procfs.go 与 limit.go 均为 linux 专属（// +build linux），
// 在 GOOS=windows 下 platform 包没有任何文件，会导致 app/tun.go 与
// delegate/init.go 引用的以下两个符号编译失败。这里提供桌面端语义的空实现：
//   - 不按 fd 数量限流（桌面端无此约束）；
//   - 无法按 socket 反查 UID（Android /proc 专属能力，Windows 端恒返回 -1，
//     delegate.Init 的 DefaultPackageNameResolver 将得到空包名，与未启用等价）。

package platform

import "net"

func ShouldBlockConnection() bool {
	return false
}

func QuerySocketUidFromProcFs(source, target net.Addr) int {
	return -1
}
