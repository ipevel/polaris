package cc.polaris.desktop.platform

import kotlinx.serialization.json.Json
import kotlinx.serialization.json.JsonArray
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.JsonPrimitive
import kotlinx.serialization.json.booleanOrNull
import kotlinx.serialization.json.buildJsonObject
import kotlinx.serialization.json.contentOrNull
import kotlinx.serialization.json.int
import kotlinx.serialization.json.jsonObject
import kotlinx.serialization.json.jsonPrimitive
import kotlinx.serialization.json.put
import java.io.Closeable
import java.io.RandomAccessFile
import java.nio.ByteBuffer
import java.nio.ByteOrder
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

class HelperException(message: String) : Exception(message)

/**
 * 提权服务客户端：命名管道（\\.\pipe\<name>）+ 每请求 HMAC-SHA256(timestamp:params)。
 * 密钥与 helper 的服务环境变量一致（安装期生成，宿主本地加密保存）。
 * JVM 可直接经 RandomAccessFile 打开命名管道；helper 响应均为有界小帧。
 */
class HelperClient(
    pipeName: String,
    private val authKeyHex: String,
) : Closeable {

    private val pipe = RandomAccessFile("\\\\.\\pipe\\$pipeName", "rw")

    /** 调用 helper 操作；失败抛 [HelperException]，成功返回 data（可能为空对象）。 */
    fun call(op: String, params: JsonObject = buildJsonObject { }): JsonObject {
        val ts = System.currentTimeMillis() / 1000
        val paramsJson = params.toString()

        val request = buildJsonObject {
            put("op", op)
            put("ts", ts)
            put("params", params)
            put("hmac", hmacSha256(authKeyHex, "$ts:$op:$paramsJson"))
        }

        writeFrame(pipe, request.toString().toByteArray(Charsets.UTF_8))

        val resp = Json.parseToJsonElement(String(readFrame(), Charsets.UTF_8)).jsonObject
        val ok = resp["ok"]?.jsonPrimitive?.booleanOrNull ?: false
        if (!ok) {
            throw HelperException(resp["error"]?.jsonPrimitive?.contentOrNull ?: "helper 调用失败")
        }

        return resp["data"]?.jsonObject ?: buildJsonObject { }
    }

    fun status(): JsonObject = call("status")

    fun startCore(exePath: String, port: Int): Int {
        val data = call(
            "start_core",
            buildJsonObject {
                put("exePath", exePath)
                put("port", port)
            },
        )

        return data["pid"]?.jsonPrimitive?.int ?: -1
    }

    fun stopCore(pid: Int) {
        call(
            "stop_core",
            buildJsonObject {
                put("pid", pid)
            },
        )
    }

    /** 经 helper 静默运行更新安装器（域白名单与哈希由 helper 服务端复核）。 */
    fun runUpdateInstaller(exePath: String, expectedSha256: String, sourceHost: String, args: List<String>) {
        call(
            "run_update_installer",
            buildJsonObject {
                put("exePath", exePath)
                put("expectedSha256", expectedSha256)
                put("sourceHost", sourceHost)
                put("args", JsonArray(args.map { JsonPrimitive(it) }))
            },
        )
    }

    override fun close() {
        try {
            pipe.close()
        } catch (_: Exception) {
        }
    }

    private fun hmacSha256(keyHex: String, message: String): String {
        val mac = Mac.getInstance("HmacSHA256")
        mac.init(SecretKeySpec(hexToBytes(keyHex), "HmacSHA256"))

        return mac.doFinal(message.toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it) }
    }

    private fun hexToBytes(hex: String): ByteArray {
        val out = ByteArray(hex.length / 2)

        for (i in out.indices) {
            out[i] = ((Character.digit(hex[i * 2], 16) shl 4) + Character.digit(hex[i * 2 + 1], 16)).toByte()
        }

        return out
    }

    private fun writeFrame(output: RandomAccessFile, data: ByteArray) {
        val header = ByteArray(4)
        ByteBuffer.wrap(header).order(ByteOrder.LITTLE_ENDIAN).putInt(data.size)
        output.write(header)
        output.write(data)
    }

    private fun readFrame(): ByteArray {
        val header = ByteArray(4)
        readFully(header)

        val length = ByteBuffer.wrap(header).order(ByteOrder.LITTLE_ENDIAN).int
        require(length in 1..10 * 1024 * 1024) { "helper 非法帧长度: $length" }

        val data = ByteArray(length)
        readFully(data)

        return data
    }

    private fun readFully(buf: ByteArray) {
        var offset = 0
        while (offset < buf.size) {
            val n = pipe.read(buf, offset, buf.size - offset)
            if (n < 0) {
                throw HelperException("helper 管道已关闭")
            }

            offset += n
        }
    }
}
