package cc.polaris.desktop.platform

/** schtasks 开机自启（当前用户登录时启动）。 */
object AutoStart {

    private const val TASK_NAME = "PolarisDesktop"

    fun enable(exePath: String): Boolean =
        exec("schtasks", "/Create", "/F", "/TN", TASK_NAME, "/SC", "ONLOGON", "/TR", "\"$exePath\"")

    fun disable(): Boolean = exec("schtasks", "/Delete", "/F", "/TN", TASK_NAME)

    fun enabled(): Boolean = exec("schtasks", "/Query", "/TN", TASK_NAME)

    private fun exec(vararg command: String): Boolean = try {
        ProcessBuilder(*command)
            .redirectErrorStream(true)
            .start()
            .waitFor() == 0
    } catch (_: Exception) {
        false
    }
}
