package cc.polaris.desktop.rpc

import kotlinx.coroutines.CompletableDeferred
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.Job
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.TimeoutCancellationException
import kotlinx.coroutines.channels.BufferOverflow
import kotlinx.coroutines.channels.Channel
import kotlinx.coroutines.flow.MutableSharedFlow
import kotlinx.coroutines.flow.SharedFlow
import kotlinx.coroutines.flow.asSharedFlow
import kotlinx.coroutines.isActive
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import kotlinx.coroutines.withTimeout
import kotlinx.serialization.json.Json
import kotlinx.serialization.json.JsonElement
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.jsonObject
import kotlinx.serialization.json.jsonPrimitive
import java.io.BufferedInputStream
import java.io.BufferedOutputStream
import java.io.DataInputStream
import java.net.InetAddress
import java.net.InetSocketAddress
import java.net.ServerSocket
import java.net.Socket
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.atomic.AtomicLong

/**
 * 宿主侧与 PolarisCore 的连接管理（Bettbox 同款反向连接范式）：
 *  1. 绑定回环随机端口 → 调用方经 [awaitCore] 的 launch 回调拉起 core → accept 反向连接；
 *  2. 读循环：事件帧进 [events]（SharedFlow），响应帧按 id 唤醒等待者；
 *  3. [request] 挂起至对应响应或超时。
 *
 * 线程模型（T13 评审修订）：
 *  - 写走独立写协程 + Channel：send 可被超时取消，阻塞写不再拖死调用方；
 *    超时后 close() 复位连接，写协程随 socket 错误退出；
 *  - 事件缓冲满时丢弃最旧事件（fetchDone 等关键事件另有直接确认路径）。
 */
class CoreConnection(
    private val connectTimeoutMs: Int = 15_000,
    private val requestTimeoutMs: Long = 60_000,
) : AutoCloseable {

    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
    private val _events = MutableSharedFlow<RpcEvent>(
        extraBufferCapacity = 512,
        onBufferOverflow = BufferOverflow.DROP_OLDEST,
    )
    val events: SharedFlow<RpcEvent> = _events.asSharedFlow()

    private val json = Json { ignoreUnknownKeys = true; explicitNulls = false }
    private val nextId = AtomicLong(1)
    private val pending = ConcurrentHashMap<Long, CompletableDeferred<RpcResponse>>()
    private val writeLock = Any()
    private val writeQueue = Channel<ByteArray>(capacity = 64)

    private var socket: Socket? = null
    private var writer: Job? = null
    private var reader: Job? = null
    private var closed = false

    /** core 反连使用的宿主监听端口；0 表示未建立连接。 */
    var listenPort: Int = 0
        private set

    val connected: Boolean
        get() = !closed && socket?.isConnected == true

    /**
     * 监听随机回环端口并以 [launch] 拉起 core，等待其反向连接。
     * core 启动失败或超时都会抛出异常（含 Go 侧已因反向连接失败自行退出的语义）。
     */
    suspend fun awaitCore(launch: (port: Int) -> Unit) {
        check(socket == null && !closed) { "连接已建立或已关闭" }

        val server = ServerSocket()
        try {
            server.reuseAddress = true
            server.bind(InetSocketAddress(InetAddress.getLoopbackAddress(), 0))
            listenPort = server.localPort

            launch(listenPort)

            server.soTimeout = connectTimeoutMs
            val accepted = try {
                server.accept()
            } catch (e: Exception) {
                throw IllegalStateException("core 未在 ${connectTimeoutMs}ms 内反向连接", e)
            }

            attach(accepted)
        } finally {
            if (socket == null) {
                listenPort = 0
            }

            server.close()
        }
    }

    /** 发起一次 RPC；ok=false 抛 [RpcException]。返回 data 字段。 */
    suspend fun request(method: String, params: JsonObject? = null): JsonElement? {
        val resp = requestFull(method, params)
        if (!resp.ok) {
            throw RpcException(resp.error ?: "未知错误")
        }

        return resp.data
    }

    suspend fun requestFull(method: String, params: JsonObject? = null): RpcResponse {
        if (closed || socket == null) {
            throw RpcException("core 未连接")
        }

        val id = nextId.getAndIncrement()
        val deferred = CompletableDeferred<RpcResponse>()
        pending[id] = deferred

        try {
            val frame = json.encodeToString(
                RpcRequest.serializer(),
                RpcRequest(id, method, params),
            ).toByteArray(Charsets.UTF_8)

            return try {
                withTimeout(requestTimeoutMs) {
                    withContext(Dispatchers.IO) { writeQueue.send(frame) }
                    deferred.await()
                }
            } catch (_: TimeoutCancellationException) {
                // 写挂起或响应未达：状态不可知，直接复位连接以解锁写协程与全部等待者
                close()
                throw RpcException("$method 超时（${requestTimeoutMs}ms），连接已重置")
            }
        } finally {
            pending.remove(id)
        }
    }

    override fun close() {
        if (closed) {
            return
        }

        closed = true

        try {
            socket?.close()
        } catch (_: Exception) {
        }

        writeQueue.close()
        writer?.cancel()
        reader?.cancel()

        socket = null
        failAllPending("core 连接已关闭")
    }

    private fun attach(accepted: Socket) {
        socket = accepted
        accepted.tcpNoDelay = true

        val input = DataInputStream(BufferedInputStream(accepted.getInputStream()))
        val output = BufferedOutputStream(accepted.getOutputStream())

        // 独立写协程：requestFull 的 send 可取消，阻塞写只占写协程本身
        writer = scope.launch {
            try {
                for (frame in writeQueue) {
                    synchronized(writeLock) { writeFrame(output, frame) }
                }
            } catch (_: Exception) {
                // socket 关闭/写失败：读循环会统一收尾
            }
        }

        reader = scope.launch {
            try {
                while (isActive) {
                    handleFrame(readFrame(input))
                }
            } catch (_: Exception) {
                // 读循环退出：统一失败所有等待者
            } finally {
                failAllPending("core 连接已断开")
                close()
            }
        }
    }

    private fun handleFrame(frame: ByteArray) {
        val obj = json.parseToJsonElement(String(frame, Charsets.UTF_8)).jsonObject

        // 事件帧：{"event": ..., "payload": ...}；响应帧：{"id": ...}
        if (obj.containsKey("event")) {
            val event = json.decodeFromJsonElement(RpcEvent.serializer(), obj)
            _events.tryEmit(event)

            return
        }

        val resp = json.decodeFromJsonElement(RpcResponse.serializer(), obj)
        pending.remove(resp.id)?.complete(resp)
    }

    private fun failAllPending(reason: String) {
        for ((_, deferred) in pending) {
            deferred.completeExceptionally(RpcException(reason))
        }

        pending.clear()
    }
}
