/** 组类型中文化。 */
private fun d2Type(type: String): String = when (type) {
    "Selector" -> "手动选择"
    "URLTest" -> "自动测速"
    "Fallback" -> "故障转移"
    "LoadBalance" -> "负载均衡"
    else -> type
}

/** 代理组详情（内核 tunnel.queryGroup 返回，结构对齐安卓 native/tunnel QueryProxyGroup）。 */
private data class GroupDetail(
    val type: String,
    val now: String?,
    val proxies: List<ProxyItem>,
)

private data class ProxyItem(
    val name: String,
    val type: String,
    val subtitle: String?,
    val delay: Int,
    val isGroup: Boolean,
)

/** 代理页（T15f）：组筛选 + 节点卡片 + 测速 + 选择（对齐安卓 Server 页语义）。 */
@Composable
fun ProxiesScreen(manager: CoreManager) {
    val scope = rememberCoroutineScope()
    var groupNames by remember { mutableStateOf<List<String>>(emptyList()) }
    var selectedGroup by remember { mutableStateOf<String?>(null) }
    var detail by remember { mutableStateOf<GroupDetail?>(null) }
    var loading by remember { mutableStateOf(false) }
    var error by remember { mutableStateOf<String?>(null) }

    fun loadGroups() {
        scope.launch {
            loading = true
            error = null
            try {
                val names = withContext(Dispatchers.IO) {
                    manager.rpc("tunnel.queryGroupNames", kotlinx.serialization.json.buildJsonObject {
                        put("excludeNotSelectable", true)
                    })?.jsonArray?.mapNotNull { (it as? JsonPrimitive)?.contentOrNull }
                } ?: emptyList()
                groupNames = names
                if (selectedGroup == null && names.isNotEmpty()) {
                    selectedGroup = names.first()
                }
            } catch (e: Exception) {
                error = e.message
            } finally {
                loading = false
            }
        }
    }

    fun loadGroupDetail(group: String) {
        scope.launch {
            loading = true
            error = null
            try {
                val resp = withContext(Dispatchers.IO) {
                    manager.rpc("tunnel.queryGroup", kotlinx.serialization.json.buildJsonObject {
                        put("name", group)
                        put("sort", "Default")
                    })
                }?.jsonObject

                detail = resp?.let {
                    GroupDetail(
                        type = it["type"]?.jsonPrimitive?.contentOrNull ?: "",
                        now = it["now"]?.jsonPrimitive?.contentOrNull,
                        proxies = it["proxies"]?.jsonArray?.map { p ->
                            val o = p.jsonObject
                            ProxyItem(
                                name = o["name"]?.jsonPrimitive?.contentOrNull ?: "",
                                type = o["type"]?.jsonPrimitive?.contentOrNull ?: "",
                                subtitle = o["subtitle"]?.jsonPrimitive?.contentOrNull,
                                delay = o["delay"]?.jsonPrimitive?.contentOrNull?.toIntOrNull() ?: 0,
                                isGroup = o["isGroup"]?.jsonPrimitive?.contentOrNull == "true",
                            )
                        } ?: emptyList(),
                    )
                }
            } catch (e: Exception) {
                error = e.message
            } finally {
                loading = false
            }
        }
    }

    LaunchedEffect(Unit) { loadGroups() }
    LaunchedEffect(selectedGroup) { selectedGroup?.let { loadGroupDetail(it) } }

    Column(Modifier.fillMaxSize(), verticalArrangement = Arrangement.spacedBy(12.dp)) {
        // 页头：标题 + 操作
        PageHeader(
            title = "代理",
            subtitle = detail?.let { "${d2Type(it.type)} · 当前：${it.now ?: "-"}" } ?: "选择策略组中的节点",
        ) {
            Button(onClick = {
                scope.launch {
                    try {
                        // healthCheckAll 为异步派发（立即返回）；随后短轮询回读延迟，避免阻塞等待
                        withContext(Dispatchers.IO) { manager.rpc("tunnel.healthCheckAll") }
                        repeat(6) {
                            delay(2_000)
                            selectedGroup?.let { g -> loadGroupDetail(g) }
                        }
                    } catch (e: Exception) {
                        error = e.message
                    }
                }
            }, enabled = !loading) { Text("测试延迟") }
        }

        // 组筛选 chips（横向滚动，组多时不被裁剪）
        if (groupNames.isNotEmpty()) {
            Row(
                Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
                horizontalArrangement = Arrangement.spacedBy(8.dp),
            ) {
                groupNames.forEach { name ->
                    FilterChip(
                        selected = name == selectedGroup,
                        onClick = { selectedGroup = name },
                        label = { Text(name, maxLines = 1, overflow = TextOverflow.Ellipsis) },
                    )
                }
            }
        }

        error?.let { Text("错误：$it", color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall) }

        val d = detail
        if (d == null) {
            CommonCard(Modifier.fillMaxWidth()) {
                Column(
                    Modifier.fillMaxWidth().padding(vertical = 40.dp),
                    horizontalAlignment = Alignment.CenterHorizontally,
                ) {
                    Text(if (loading) "加载中…" else "连接后展示代理组", style = MaterialTheme.typography.titleMedium)
                    Spacer(Modifier.height(4.dp))
                    Text("连接成功后可在此选择节点", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.outline)
                }
            }
        } else {
            LazyVerticalGrid(
                columns = GridCells.Adaptive(220.dp),
                horizontalArrangement = Arrangement.spacedBy(10.dp),
                verticalArrangement = Arrangement.spacedBy(10.dp),
                modifier = Modifier.weight(1f),
            ) {
                // 过滤订阅 YAML 里的信息假节点（剩余流量/到期/重置），只显示真实代理节点
                val realProxies = d.proxies.filterNot { p ->
                    p.name.contains(Regex("剩余|到期|重置| expire|流量", RegexOption.IGNORE_CASE))
                }
                items(realProxies, key = { it.name }) { proxy ->
                    val selected = proxy.name == d.now
                    ProxyCard(
                        proxy = proxy,
                        selected = selected,
                        onClick = {
                            val group = selectedGroup
                            if (group != null) {
                                scope.launch {
                                    try {
                                        withContext(Dispatchers.IO) {
                                            manager.rpc("tunnel.patchSelector", kotlinx.serialization.json.buildJsonObject {
                                                put("selector", group)
                                                put("name", proxy.name)
                                            })
                                        }
                                        loadGroupDetail(group)
                                    } catch (e: Exception) {
                                        error = e.message
                                    }
                                }
                            }
                        },
                    )
                }
            }
        }
    }
}

@Composable
private fun ProxyCard(proxy: ProxyItem, selected: Boolean, onClick: () -> Unit) {
    Column(
        Modifier
            .fillMaxWidth()
            .background(
                if (selected) BettboxColors.accentContainer else BettboxColors.cardBg,
                RoundedCornerShape(12.dp),
            )
            .border(
                width = if (selected) 2.dp else 1.dp,
                color = if (selected) BettboxColors.accent else BettboxColors.divider,
                shape = RoundedCornerShape(12.dp),
            )
            .clickable(onClick = onClick)
            .padding(12.dp),
    ) {
        // 节点名 + 选中标记
        Row(verticalAlignment = Alignment.CenterVertically) {
            Text(proxy.name, style = MaterialTheme.typography.bodyMedium, fontWeight = FontWeight.SemiBold, modifier = Modifier.weight(1f), maxLines = 1, overflow = TextOverflow.Ellipsis)
            if (selected) {
                Spacer(Modifier.width(6.dp))
                Text("✓", color = BettboxColors.accent, style = MaterialTheme.typography.labelLarge, fontWeight = FontWeight.Bold)
            }
        }
        Spacer(Modifier.height(6.dp))
        Row(verticalAlignment = Alignment.CenterVertically) {
            // 协议徽章
            Badge(proxy.type.uppercase(), BettboxColors.accent)
            Spacer(Modifier.weight(1f))
            val (delayText, delayColor) = when {
                // 0 = 未测速，65535 = 测速失败/超时（内核哨兵值），一律显示占位
                proxy.delay <= 0 || proxy.delay >= 60000 -> "—" to MaterialTheme.colorScheme.outline
                proxy.delay < 200 -> "${proxy.delay}ms" to BettboxColors.upColor
                proxy.delay < 500 -> "${proxy.delay}ms" to BettboxColors.warning
                else -> "${proxy.delay}ms" to MaterialTheme.colorScheme.error
            }
            Text(delayText, style = MaterialTheme.typography.labelSmall, color = delayColor, fontWeight = FontWeight.SemiBold)
        }
        proxy.subtitle?.takeIf { it.isNotBlank() }?.let {
            Spacer(Modifier.height(4.dp))
            Text(it, style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.outline, maxLines = 1, overflow = TextOverflow.Ellipsis)
        }
    }
}
