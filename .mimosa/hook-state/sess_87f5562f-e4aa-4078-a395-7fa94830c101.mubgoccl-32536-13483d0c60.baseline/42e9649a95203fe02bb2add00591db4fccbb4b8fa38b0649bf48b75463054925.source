package cc.polaris.desktop.platform

import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.Json
import java.net.URI
import java.nio.file.Files
import java.nio.file.Path
import java.security.MessageDigest

/**
 * 自更新（对照评审 P0-1「更新通道零校验」教训的宿主侧实现）：
 *  1. 检查清单 manifest.json {version,url,sha256}；
 *  2. 下载到临时目录并本地计算 SHA-256；
 *  3. 经 helper 的 run_update_installer 复核（源域白名单 + 再次哈希）后静默安装。
 * 校验链任何一环失败即中止，不回退到无校验路径。
 */
class Updater(
    private val helperProvider: () -> HelperClient?,
) {

    @Serializable
    data class Manifest(
        val version: String,
        val url: String,
        val sha256: String,
    )

    suspend fun check(currentVersion: String, manifestUrl: String): Manifest? = withContext(Dispatchers.IO) {
        val text = URI(manifestUrl).toURL().readText(Charsets.UTF_8)
        val manifest = Json.decodeFromString(Manifest.serializer(), text)

        if (manifest.version != currentVersion) manifest else null
    }

    fun download(manifest: Manifest): Path = downloadTo(manifest, Files.createTempFile("polaris-update-", ".exe"))

    private fun downloadTo(manifest: Manifest, target: Path): Path {
        URI(manifest.url).toURL().openStream().use { input ->
            Files.copy(input, target, java.nio.file.StandardCopyOption.REPLACE_EXISTING)
        }

        val actual = fileSha256(target)
        if (!actual.equals(manifest.sha256, ignoreCase = true)) {
            Files.deleteIfExists(target)
            throw IllegalStateException("更新包哈希校验失败: $actual")
        }

        return target
    }

    /** 经提权服务静默安装；返回是否成功发起。 */
    fun install(manifest: Manifest, installerPath: Path): Boolean {
        val helper = helperProvider() ?: throw IllegalStateException("提权服务未连接，无法自动更新")
        val host = runCatching { URI(manifest.url).host ?: "" }.getOrDefault("")

        helper.runUpdateInstaller(
            installerPath.toString(),
            manifest.sha256,
            host,
            listOf("/VERYSILENT", "/NORESTART"),
        )

        return true
    }

    private fun fileSha256(path: Path): String {
        val md = MessageDigest.getInstance("SHA-256")

        Files.newInputStream(path).use { input ->
            val buf = ByteArray(64 * 1024)
            while (true) {
                val n = input.read(buf)
                if (n < 0) {
                    break
                }

                md.update(buf, 0, n)
            }
        }

        return md.digest().joinToString("") { "%02x".format(it) }
    }
}
