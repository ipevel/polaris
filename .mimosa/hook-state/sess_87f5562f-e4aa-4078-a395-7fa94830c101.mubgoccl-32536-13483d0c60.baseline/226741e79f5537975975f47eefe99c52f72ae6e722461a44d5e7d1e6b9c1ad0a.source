//go:build windows

package main

// RPC 协议定义与分发。
//
//	请求（宿主 → 内核）：{"id":1,"method":"config.load","params":{...}}
//	响应（内核 → 宿主）：{"id":1,"ok":true,"data":...} 或 {"id":1,"ok":false,"error":"..."}
//	事件（内核 → 宿主，无 id）：{"event":"log","payload":{...}}
//
// 约定：
//   - id 由宿主生成，内核原样回填；事件帧无 id。
//   - 方法名以点号分组（core. / config. / tunnel. / proxy. / app.），
//     与 Android 端 JNI 导出面（native/*.go 的 //export 函数）一一对应。
//   - 任意 handler 的 panic 都会被 dispatch 捕获并转为错误响应，
//     不会带崩内核进程（对齐评审报告对 Android 端 Error 逃逸问题的整改方向）。

import (
	"encoding/json"
	"fmt"
)

type Request struct {
	Id     uint64          `json:"id"`
	Method string          `json:"method"`
	Params json.RawMessage `json:"params,omitempty"`
}

type Response struct {
	Id    uint64 `json:"id"`
	Ok    bool   `json:"ok"`
	Data  any    `json:"data,omitempty"`
	Error string `json:"error,omitempty"`
}

type Event struct {
	Event   string `json:"event"`
	Payload any    `json:"payload,omitempty"`
}

type handler func(params json.RawMessage) (any, error)

var handlers = map[string]handler{}

func register(method string, h handler) {
	if _, dup := handlers[method]; dup {
		panic("duplicate handler: " + method)
	}

	handlers[method] = h
}

func decodeParams(raw json.RawMessage, v any) error {
	if len(raw) == 0 {
		return nil
	}

	return json.Unmarshal(raw, v)
}

func dispatch(req *Request) (resp *Response) {
	defer func() {
		if r := recover(); r != nil {
			resp = &Response{
				Id:    req.Id,
				Ok:    false,
				Error: fmt.Sprintf("panic in %s: %v", req.Method, r),
			}
		}
	}()

	h, ok := handlers[req.Method]
	if !ok {
		return &Response{Id: req.Id, Ok: false, Error: "unknown method: " + req.Method}
	}

	data, err := h(req.Params)
	if err != nil {
		return &Response{Id: req.Id, Ok: false, Error: err.Error()}
	}

	return &Response{Id: req.Id, Ok: true, Data: data}
}
