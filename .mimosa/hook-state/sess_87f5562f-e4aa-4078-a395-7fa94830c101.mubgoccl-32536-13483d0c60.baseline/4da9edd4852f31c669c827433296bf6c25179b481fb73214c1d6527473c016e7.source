/** 应用数据目录：%APPDATA%/Polaris。 */
fun appDataHome(): Path {
    val appData = System.getenv("APPDATA")
        ?: (System.getProperty("user.home") + "/AppData/Roaming")

    return Path.of(appData, "Polaris")
}

/** core 可执行文件查找顺序：
 *  1. %APPDATA%/Polaris/bin（开发/绿色布局）
 *  2. %ProgramFiles%/Polaris/bin（Inno 安装器布局，{app}\bin）
 *  3. jpackage app-image 布局：PolarisDesktop.exe 的上级目录（dist\PolarisCore.exe 与 app 目录平级）
 *  4. 工作目录（开发模式裸跑）
 *  5. 工作目录上一级（绿色包解压后直接双击的兜底） */
fun resolveCoreExe(appHome: Path): Path {
    val candidates = buildList {
        add(appHome.resolve("bin").resolve("PolarisCore.exe"))
        add(
            Path.of(System.getenv("ProgramFiles") ?: "C:\\Program Files").resolve("Polaris")
                .resolve("bin").resolve("PolarisCore.exe"),
        )
        // jpackage 启动器会把自身 exe 路径写入系统属性 jpackage.app-path
        System.getProperty("jpackage.app-path")?.let { exePath ->
            Path.of(exePath).toAbsolutePath().parent?.let { appDir ->
                add(appDir.resolveSibling("PolarisCore.exe"))
                add(appDir.resolve("PolarisCore.exe"))
            }
        }
        add(Path.of("PolarisCore.exe").toAbsolutePath())
        add(Path.of("..", "PolarisCore.exe").toAbsolutePath().normalize())
    }

    return candidates.firstOrNull { Files.exists(it) } ?: candidates.first()
}

/** helper 服务配置（安装期写入；密钥加密存储由 T11 DPAPI 收口）。 */
fun loadHelperConfig(appHome: Path): HelperConfig? {
    val file = appHome.resolve("helper.json")
    if (!Files.exists(file)) {
        return null
    }

    return runCatching {
        Json.decodeFromString(HelperConfig.serializer(), Files.readString(file))
    }.getOrNull()
}

/** 崩溃转储：未捕获异常落盘（评审 P0-4 裸线程教训的配套兜底）。 */
fun installCrashHandler(appHome: Path) {
    Thread.setDefaultUncaughtExceptionHandler { thread, throwable ->
        try {
            val logs = appHome.resolve("logs")
            Files.createDirectories(logs)

            val stack = StringWriter().also { throwable.printStackTrace(PrintWriter(it)) }.toString()
            Files.writeString(
                logs.resolve("crash-${Instant.now().toEpochMilli()}.txt"),
                "thread: ${thread.name}\n\n$stack",
            )
        } catch (_: Exception) {
        }
    }
}

/** 单实例握手端口（仅回环；避开 7890 代理端口）。 */
private const val SINGLE_INSTANCE_PORT = 7891

/**
 * 已有实例在运行时，通知它显示主窗口并返回 true（本进程随即退出）——
 * 双击 exe 永远唤起唯一实例，不再出现新旧两个进程并存（用户要求）。
 */
private fun notifyExistingInstance(): Boolean = runCatching {
    java.net.Socket().use { socket ->
        socket.connect(java.net.InetSocketAddress(java.net.InetAddress.getLoopbackAddress(), SINGLE_INSTANCE_PORT), 300)
        socket.getOutputStream().write("SHOW\n".toByteArray())
        socket.getOutputStream().flush()
    }
    true
}.getOrDefault(false)

/** 常驻监听握手端口；收到 SHOW 即唤起主窗口（daemon 线程，不阻碍退出）。 */
private fun startSingleInstanceServer() {
    Thread {
        runCatching {
            java.net.ServerSocket(SINGLE_INSTANCE_PORT, 8, java.net.InetAddress.getLoopbackAddress()).use { server ->
                while (!server.isClosed) {
                    val client = runCatching { server.accept() }.getOrNull() ?: break
                    client.use {
                        val text = it.getInputStream().readNBytes(64).toString(Charsets.UTF_8)
                        if (text.trim() == "SHOW") {
                            SwingUtilities.invokeLater {
                                // 不依赖 Compose 组合期：直接在 AWT 层找到应用窗口置前
                                java.awt.Window.getWindows()
                                    .filterIsInstance<androidx.compose.ui.awt.ComposeWindow>()
                                    .firstOrNull()
                                    ?.let { w ->
                                        w.isVisible = true
                                        w.extendedState = java.awt.Frame.NORMAL
                                        w.toFront()
                                    }
                            }
                        }
                    }
                }
            }
        }
    }.apply {
        isDaemon = true
        name = "single-instance-listener"
        start()
    }
}

fun main() {
    // 单实例保护：旧实例活着 → 唤起其窗口，本进程直接退出
    if (notifyExistingInstance()) {
        return
    }
    // 握手服务在组合期之前启动（纯 JVM 线程，不依赖 Compose 状态）
    startSingleInstanceServer()
    application {
    val appHome = appDataHome()
    installCrashHandler(appHome)

    val helperConfig = loadHelperConfig(appHome)

    // core 哈希白名单：发布版经配置注入；开发模式空集放行（CoreLauncher 语义）
    val manager = remember {
        CoreManager(
            appHome = appHome,
            coreExe = resolveCoreExe(appHome),
            coreSha256Whitelist = emptySet(),
            helperConfig = helperConfig,
        )
    }

    // 关闭窗口 = 隐藏到托盘（代理软件惯例）；真退出走托盘菜单
    var windowVisible by remember { mutableStateOf(true) }
    val windowState = rememberWindowState(width = 1000.dp, height = 660.dp)
    val exitScope = remember { CoroutineScope(SupervisorJob() + Dispatchers.IO) }

    // T13 评审 P0：退出前停内核防泄漏；P0-2 补丁：OkHttp/Ktor 等非守护线程会阻止 JVM
    // 自然退出（窗口关了、托盘没了、进程还在——假退出 bug），必须强制终止
    val exitApp: () -> Unit = {
        exitScope.launch {
            withTimeoutOrNull(2_500) { runCatching { manager.stop() } }
            kotlin.system.exitProcess(0)
        }
    }

    // 组合前副作用（先于 Window 内容组合）：PanelGraph 必须在任何页面访问前就绪，
    // 否则 AppRoot 组合期访问 lateinit 仓库直接崩溃（18:12 crash 根因）
    DisposableEffect(Unit) {
        // 面板栈组装在组合期外一次完成（T15 评审 P2-2）；注销钩子接内核
        cc.polaris.desktop.panel.PanelGraph.init(cc.polaris.desktop.ui.coreKernelHooks(manager))

        SystemTrayHost.install(
            onShow = { windowVisible = true },
            onExit = exitApp,
        )

        onDispose { SystemTrayHost.remove() }
    }

    Window(
        onCloseRequest = { windowVisible = false },
        visible = windowVisible,
        title = "北辰 Polaris",
        state = windowState,
        undecorated = true, // 去掉 Windows 原生标题栏/边框（用户反馈），自绘应用壳
        resizable = true,
    ) {
        Column(Modifier.fillMaxSize()) {
            AppTitleBar(
                state = windowState,
                onMinimize = { windowState.isMinimized = true },
                onClose = { windowVisible = false },
            )
            AppRoot(manager)
        }
    }
    }
}

/** 应用自绘标题栏：深色、可拖拽移动、双击最大化、右侧最小化/关闭。 */
@Composable
private fun AppTitleBar(
    state: WindowState,
    onMinimize: () -> Unit,
    onClose: () -> Unit,
) {
    val density = androidx.compose.ui.platform.LocalDensity.current.density
    val scope = rememberCoroutineScope()

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .height(36.dp)
            .background(cc.polaris.desktop.ui.BettboxColors.sidebar)
            .pointerInput(Unit) {
                detectDragGestures { change, dragAmount ->
                    change.consume()
                    // Compose px → dp：窗口位移在 125%/150% 缩放下与拖拽量等比
                    state.position = WindowPosition.Absolute(
                        x = state.position.x + (dragAmount.x / density).dp,
                        y = state.position.y + (dragAmount.y / density).dp,
                    )
                }
            }
            .pointerInput(Unit) {
                detectTapGestures(
                    onDoubleTap = {
                        state.placement =
                            if (state.placement == WindowPlacement.Maximized) WindowPlacement.Floating else WindowPlacement.Maximized
                    },
                )
            }
            .padding(horizontal = 12.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(8.dp),
    ) {
        Box(
            Modifier.size(14.dp).background(cc.polaris.desktop.ui.BettboxColors.accent, androidx.compose.foundation.shape.CircleShape),
        )
        Text(
            "北辰 Polaris",
            color = Color(0xFFE8EAED),
            style = MaterialTheme.typography.labelMedium,
            modifier = Modifier.weight(1f),
        )
        TextButton(
            onClick = onMinimize,
            modifier = Modifier.height(30.dp),
            contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = 10.dp),
        ) { Text("─", color = Color(0xFF9AA0A6)) }
        TextButton(
            onClick = {
                scope.launch {
                    state.placement =
                        if (state.placement == WindowPlacement.Maximized) WindowPlacement.Floating else WindowPlacement.Maximized
                }
            },
            modifier = Modifier.height(30.dp),
            contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = 10.dp),
        ) { Text("□", color = Color(0xFF9AA0A6)) }
        TextButton(
            onClick = onClose,
            modifier = Modifier.height(30.dp),
            contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = 10.dp),
        ) { Text("✕", color = Color(0xFF9AA0A6)) }
    }
}

