// ─── 汇总 ───
phase("汇总安卓端评审发现");

const allReports = await Promise.all([
  regressionReport, archReport, secReport, uiReport, kernelReport
]);

const aggregator = agent("评审汇总员", {
  system: "你是一位资深技术评审主席，擅长将多位专家意见汇总为结构化报告。按严重程度排序，跨域去重合并，标注交叉验证，给出总体评级和关键建议。用中文输出。"
});

const finalReport = await aggregator.ask<string>(`你是评审主席，将以下五位安卓端专家的评审报告汇总为一份综合评审报告。

五位专家的报告：
${JSON.stringify(allReports, null, 2)}

输出要求：
1. 总体评级（优秀/良好/需改进/不合格），附理由
2. 最新变更专项（变更回归评审员的发现单独成节）
3. P0 发现汇总表（按安全 > 功能 > 架构排序）
4. P1 发现汇总表
5. P2 发现汇总表
6. 各域亮点
7. 跨域交叉验证（多专家独立发现 = 高确信度）
8. 关键建议（Top 5 优先行动项）
9. 遗留风险清单

格式：纯 Markdown，表格清晰。`);

await artifact.markdown("slte-android-review", finalReport, {
  title: "SLTE 安卓端 v1.4.1 专家评审报告",
  description: "五域专家团队对安卓端最新版的综合评审，含变更回归分析",
  primary: true
});

return finalReport;
